}

# ── Main dispatcher ───────────────────────────────────────────────────────────
main() {
  check_dependencies

  local cmd="${1:-}"

  case "$cmd" in
    --version|-V)
      echo "git-profile version ${VERSION}"
      ;;
    --help|-h|help)
      show_help
      ;;
    list)
      shift
      cmd_list "$@"
      ;;
    add)
      shift
      cmd_add "$@"
      ;;
    edit)
      shift
      cmd_edit "$@"
      ;;
    remove|rm)
      shift
      cmd_remove "$@"
      ;;
    use)
      shift
      cmd_use "$@"
      ;;
    show)
      shift
      cmd_show "$@"
      ;;
    install)
      shift
      cmd_install "$@"
      ;;
    check)
      shift
      cmd_check "$@"
      ;;
    current)
      shift
      cmd_current "$@"
      ;;
    remote)
      shift
      cmd_remote "$@"
      ;;
    rule)
      shift
      cmd_rule "$@"
      ;;
    # Hidden internal commands for testing and internal use
    _write_profile)
      shift
      cmd_internal_write_profile "$@"
      ;;
    _delete_section)
      shift
      cmd_internal_delete_section "$@"
      ;;
    _write_rule)
      shift
      cmd_internal_write_rule "$@"
      ;;
    _add_profile)
      shift
      cmd_internal_add_profile "$@"
      ;;
    _add_profile_with_keygen)
      shift
      cmd_internal_add_profile_with_keygen "$@"
      ;;
    _rule_add)
      shift
      if [[ $# -lt 3 ]]; then
        echo "Usage: git-profile _rule_add <rule_name> <dir> <profile>" >&2
        exit 1
      fi
      _rule_add "$1" "$2" "$3"
      ;;
    _rule_remove)
      shift
      if [[ $# -lt 1 ]]; then
        echo "Usage: git-profile _rule_remove <rule_name>" >&2
        exit 1
      fi
      _rule_remove "$1"
      ;;
    _edit_profile)
      shift
      if [[ $# -lt 5 ]]; then
        echo "Usage: git-profile _edit_profile <name> <new_name> <new_email> <new_host> <new_key>" >&2
        exit 1
      fi
      _edit_profile "$1" "$2" "$3" "$4" "$5"
      ;;
    _remove_profile)
      shift
      if [[ $# -lt 1 ]]; then
        echo "Usage: git-profile _remove_profile <name>" >&2
        exit 1
      fi
      _remove_profile "$1"
      ;;
    _url_https_to_ssh)
      shift
      url_https_to_ssh "$1" "$2"
      ;;
    _url_ssh_to_https)
      shift
      url_ssh_to_https "$1" "$2"
      ;;
    _profile_ssh_host)
      shift
      profile_ssh_host "$1"
      ;;
    "")
      interactive_menu
      exit 0
      ;;
    *)
      echo "git-profile: unknown subcommand '${cmd}'" >&2
      echo "Run 'git-profile --help' for usage." >&2
      exit 1
      ;;
  esac
}

main "$@"
