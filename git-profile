#!/usr/bin/env bash
# git-profile — manage per-context Git identities
set -euo pipefail

VERSION="0.1.0"

# ── Environment-overridable config paths ─────────────────────────────────────
CONF_FILE="${CONF_FILE:-${HOME}/.git-profiles.conf}"
GITCONFIG_D="${GITCONFIG_D:-${HOME}/.gitconfig.d}"

# ── Utility: resolve a path with realpath fallback ───────────────────────────
resolve_path() {
  local path="$1"
  if command -v realpath &>/dev/null; then
    realpath "$path" 2>/dev/null || echo "$path"
  else
    # Bash 3.2 compatible fallback
    local dir base
    dir="$(cd "$(dirname "$path")" 2>/dev/null && pwd)" || { echo "$path"; return; }
    base="$(basename "$path")"
    echo "${dir}/${base}"
  fi
}

# ── Dependency check (Bash 3.2 compatible, no associative arrays) ─────────────
check_dependencies() {
  local missing=""
  local deps="git ssh-keygen awk sed"
  local dep
  for dep in $deps; do
    if ! command -v "$dep" &>/dev/null; then
      missing="${missing} ${dep}"
    fi
  done
  if [[ -n "$missing" ]]; then
    echo "git-profile: missing required dependencies:${missing}" >&2
    echo "Please install the missing tools and try again." >&2
    exit 1
  fi
}

# ── Help text ─────────────────────────────────────────────────────────────────
show_help() {
  cat <<EOF
Usage: git-profile <subcommand> [options]

Manage per-context Git identities via profiles.

Subcommands:
  list                     List all configured profiles
  add                      Add or update a profile (interactive)
  edit <profile>           Edit an existing profile
  remove <profile>         Remove a profile
  use <profile>            Apply a profile to the current repository
  show [profile]           Show profile details
  remote [show|set|set-ssh|set-https]
                           Manage remote URLs (HTTPS ↔ SSH conversion)
  rule [add|list|remove]   Manage auto-apply rules
  install                  Install shell integration and SSH config
  check                    Check current repository's active profile

Options:
  --help       Show this help message
  --version    Show version information

Config file: ${CONF_FILE}
Fragments:   ${GITCONFIG_D}/

Examples:
  git-profile add
  git-profile list
  git-profile use personal
  git-profile rule add
  git-profile rule list
EOF
}

# ── INI config parser ─────────────────────────────────────────────────────────
# Reads CONF_FILE and emits lines of two forms:
#   PROFILE:name:key=value
#   RULE:rulename:key=value
parse_config() {
  local conf="${1:-$CONF_FILE}"
  [[ -f "$conf" ]] || return 0

  local current_type=""   # "PROFILE" or "RULE"
  local current_name=""

  while IFS= read -r line || [[ -n "$line" ]]; do
    # Strip leading/trailing whitespace
    line="${line#"${line%%[![:space:]]*}"}"
    line="${line%"${line##*[![:space:]]}"}"

    # Skip blank lines and comments
    [[ -z "$line" || "$line" == \#* ]] && continue

    # Section header: [rule "name"] or [name]
    if [[ "$line" =~ ^\[rule[[:space:]]\"([^\"]+)\"\]$ ]]; then
      current_type="RULE"
      current_name="${BASH_REMATCH[1]}"
      continue
    fi

    if [[ "$line" =~ ^\[([a-zA-Z0-9_-]+)\]$ ]]; then
      current_type="PROFILE"
      current_name="${BASH_REMATCH[1]}"
      continue
    fi

    # Key = value line (use (.*)$ to allow empty values)
    if [[ "$line" =~ ^([a-zA-Z_][a-zA-Z0-9_]*)[[:space:]]*=[[:space:]](.*)$ ]]; then
      local key="${BASH_REMATCH[1]}"
      local val="${BASH_REMATCH[2]}"
      if [[ -n "$current_type" && -n "$current_name" ]]; then
        echo "${current_type}:${current_name}:${key}=${val}"
      fi
    fi
  done < "$conf"
}

# Get a specific field from a profile
get_profile_field() {
  local profile="$1" field="$2"
  local prefix="PROFILE:${profile}:${field}="
  local parsed
  parsed="$(parse_config)"
  local line
  while IFS= read -r line; do
    if [[ "$line" == "${prefix}"* ]]; then
      echo "${line#${prefix}}"
      return 0
    fi
  done <<< "$parsed"
}

# List all profile names
list_profile_names() {
  local parsed
  parsed="$(parse_config)"
  local line seen=""
  while IFS= read -r line; do
    if [[ "$line" == PROFILE:* ]]; then
      local rest="${line#PROFILE:}"
      local pname="${rest%%:*}"
      # Deduplicate without sort -u to avoid SIGPIPE
      if [[ "$seen" != *"|${pname}|"* ]]; then
        seen="${seen}|${pname}|"
        echo "$pname"
      fi
    fi
  done <<< "$parsed"
}

# List all rule names
list_rule_names() {
  local parsed
  parsed="$(parse_config)"
  local line seen=""
  while IFS= read -r line; do
    if [[ "$line" == RULE:* ]]; then
      local rest="${line#RULE:}"
      local rname="${rest%%:*}"
      # Deduplicate without sort -u to avoid SIGPIPE
      if [[ "$seen" != *"|${rname}|"* ]]; then
        seen="${seen}|${rname}|"
        echo "$rname"
      fi
    fi
  done <<< "$parsed"
}

# Get a specific field from a rule
get_rule_field() {
  local rulename="$1" field="$2"
  local prefix="RULE:${rulename}:${field}="
  local parsed
  parsed="$(parse_config)"
  local line
  while IFS= read -r line; do
    if [[ "$line" == "${prefix}"* ]]; then
      echo "${line#${prefix}}"
      return 0
    fi
  done <<< "$parsed"
}

# ── Config writer helpers ──────────────────────────────────────────────────────

# validate_profile_name: accepts [a-zA-Z0-9_-], rejects names starting with "rule"
validate_profile_name() {
  local name="$1"
  if [[ ! "$name" =~ ^[a-zA-Z0-9_-]+$ ]]; then
    echo "git-profile: invalid profile name '${name}'. Use only letters, digits, hyphens, underscores." >&2
    return 1
  fi
  if [[ "$name" == rule* ]]; then
    echo "git-profile: profile name may not start with 'rule'." >&2
    return 1
  fi
}

# delete_config_section: removes a section block from CONF_FILE
# For a plain profile section, pass the section name (e.g. "personal")
# For a rule section, pass "rule:rulename" (e.g. "rule:my-rule")
delete_config_section() {
  local section_arg="$1"
  local conf="${CONF_FILE}"
  [[ -f "$conf" ]] || return 0

  local header_pattern
  if [[ "$section_arg" == rule:* ]]; then
    local rulename="${section_arg#rule:}"
    header_pattern="[rule \"${rulename}\"]"
  else
    header_pattern="[${section_arg}]"
  fi

  local tmp
  tmp="$(mktemp)"

  awk -v hdr="$header_pattern" '
    BEGIN { skip = 0 }
    {
      # Detect any section header
      if ($0 ~ /^\[/) {
        if ($0 == hdr) {
          skip = 1
        } else {
          skip = 0
        }
      }
      if (!skip) print
    }
  ' "$conf" > "$tmp"

  mv "$tmp" "$conf"
}

# write_profile_section: writes (or overwrites) a [profile] section
# Usage: write_profile_section name "Full Name" "email" "host" "ssh_key"
write_profile_section() {
  local name="$1" fullname="$2" email="$3" host="$4" ssh_key="$5"

  # Delete existing section first
  delete_config_section "$name"

  # Append new section
  {
    echo ""
    echo "[${name}]"
    echo "name = ${fullname}"
    echo "email = ${email}"
    echo "host = ${host}"
    echo "ssh_key = ${ssh_key}"
  } >> "$CONF_FILE"
}

# write_rule_section: writes (or overwrites) a [rule "name"] section
# Usage: write_rule_section rulename dir profile
write_rule_section() {
  local rulename="$1" dir="$2" profile="$3"

  # Delete existing rule section first
  delete_config_section "rule:${rulename}"

  # Append new section
  {
    echo ""
    echo "[rule \"${rulename}\"]"
    echo "dir = ${dir}"
    echo "profile = ${profile}"
  } >> "$CONF_FILE"
}

# ── SSH config helpers ────────────────────────────────────────────────────────

# backup_ssh_config: backup ~/.ssh/config with a timestamp suffix
backup_ssh_config() {
  local ssh_config="${HOME}/.ssh/config"
  [[ -f "$ssh_config" ]] || return 0
  local ts
  ts="$(date +%Y%m%d%H%M%S)"
  cp "$ssh_config" "${ssh_config}.bak.${ts}"
}

# host_has_other_profiles: returns 0 (true) if the given host is used by any
# profile OTHER than the specified current profile name.
# Usage: host_has_other_profiles <host> <current_profile_name>
host_has_other_profiles() {
  local host="$1" current="$2"
  local parsed
  parsed="$(parse_config)"
  local line seen_profiles=""
  while IFS= read -r line; do
    if [[ "$line" == PROFILE:* ]]; then
      local rest="${rest_dummy-}"
      rest="${line#PROFILE:}"
      local pname="${rest%%:*}"
      # Collect unique profile names
      if [[ "$seen_profiles" != *"|${pname}|"* ]]; then
        seen_profiles="${seen_profiles}|${pname}|"
      fi
    fi
  done <<< "$parsed"

  # For each profile that isn't the current one, check if its host matches
  local pname
  while IFS= read -r line; do
    if [[ "$line" == PROFILE:* ]]; then
      local rest="${line#PROFILE:}"
      pname="${rest%%:*}"
      if [[ "$pname" != "$current" ]]; then
        local key_part="${rest#*:}"
        if [[ "$key_part" == "host=${host}" ]]; then
          return 0
        fi
      fi
    fi
  done <<< "$parsed"

  return 1
}

# write_ssh_alias: append a Host alias block to ~/.ssh/config
# Usage: write_ssh_alias <profile_name> <host> <key_path>
write_ssh_alias() {
  local name="$1" host="$2" key_path="$3"
  local ssh_config="${HOME}/.ssh/config"

  backup_ssh_config

  {
    echo ""
    echo "# git-profile: ${name}"
    echo "Host ${host}-${name}"
    echo "  HostName ${host}"
    echo "  IdentityFile ${key_path}"
    echo "  IdentitiesOnly yes"
  } >> "$ssh_config"
}

# ── URL conversion helpers ────────────────────────────────────────────────────

# url_https_to_ssh: convert HTTPS URL to SSH format
# Usage: url_https_to_ssh <https_url> <ssh_host>
# Example: url_https_to_ssh "https://github.com/user/repo.git" "github.com"
#          → git@github.com:user/repo.git
# Example: url_https_to_ssh "https://github.com/user/repo" "github.com-work"
#          → git@github.com-work:user/repo.git
url_https_to_ssh() {
  local url="$1" ssh_host="$2"

  # Strip scheme
  local without_scheme="${url#https://}"

  # Split into host and path (host is everything before first /)
  local orig_host="${without_scheme%%/*}"
  local path="${without_scheme#*/}"

  # Ensure path ends with .git
  if [[ "$path" != *.git ]]; then
    path="${path}.git"
  fi

  echo "git@${ssh_host}:${path}"
}

# url_ssh_to_https: convert SSH URL to HTTPS format
# Usage: url_ssh_to_https <ssh_url> <real_host>
# Example: url_ssh_to_https "git@github.com-work:user/repo.git" "github.com"
#          → https://github.com/user/repo.git
url_ssh_to_https() {
  local url="$1" real_host="$2"

  # Strip git@ prefix
  local without_prefix="${url#git@}"

  # Split at : into host and path
  local path="${without_prefix#*:}"

  echo "https://${real_host}/${path}"
}

# profile_ssh_host: return the SSH host for a profile
# If multi-account on same host and SSH alias exists, returns host-profilename
# Otherwise returns the raw host
profile_ssh_host() {
  local profile_name="$1"
  local host
  host="$(get_profile_field "$profile_name" "host")"

  if [[ -z "$host" ]]; then
    echo ""
    return 1
  fi

  # Check if there are other profiles on the same host
  if host_has_other_profiles "$host" "$profile_name"; then
    # Multi-account scenario — check if SSH alias exists in ~/.ssh/config
    local alias_host="${host}-${profile_name}"
    local ssh_config="${HOME}/.ssh/config"
    if [[ -f "$ssh_config" ]] && grep -q "Host ${alias_host}" "$ssh_config" 2>/dev/null; then
      echo "$alias_host"
      return 0
    fi
  fi

  echo "$host"
}

# ── Add profile core logic ─────────────────────────────────────────────────────

# _add_profile: core add logic
# Usage: _add_profile <name> <user> <email> <host> <key_path>
_add_profile() {
  local name="$1" fullname="$2" email="$3" host="$4" key_path="$5"

  # Validate profile name
  validate_profile_name "$name" || exit 1

  # Write the profile section first
  write_profile_section "$name" "$fullname" "$email" "$host" "$key_path"

  # After writing, check if this host is used by any OTHER profile
  # 无密钥时跳过 SSH alias 逻辑（不存在密钥冲突问题）
  if [[ -n "$key_path" ]] && host_has_other_profiles "$host" "$name"; then
    # Multiple accounts on the same host — need SSH alias
    local do_write="${GIT_PROFILE_AUTO_CONFIRM:-}"
    if [[ "$do_write" != "y" ]]; then
      echo "Multiple profiles share the host '${host}'."
      echo "To avoid SSH key conflicts, an SSH alias will be added for this profile."
      printf "Write SSH alias to ~/.ssh/config? [Y/n] "
      read -r answer
      case "$answer" in
        [nN]*)  do_write="n" ;;
        *)      do_write="y" ;;
      esac
    fi

    if [[ "$do_write" == "y" ]]; then
      write_ssh_alias "$name" "$host" "$key_path"
    fi
  fi
  # Single account for this host — do NOT write to ~/.ssh/config
}

# _add_profile_with_keygen: generate SSH key then call _add_profile
# Usage: _add_profile_with_keygen <name> <user> <email> <host> <algorithm>
_add_profile_with_keygen() {
  local name="$1" fullname="$2" email="$3" host="$4" algorithm="${5:-ed25519}"
  local key_path="${HOME}/.ssh/git_profile_${name}"

  # Generate SSH key (no passphrase, quiet)
  ssh-keygen -t "$algorithm" -C "${email}" -f "$key_path" -N "" -q

  # Ensure private key has correct permissions
  chmod 600 "$key_path"

  # Display the public key for the user
  echo ""
  echo "Public key (add this to your Git platform):"
  echo "---"
  cat "${key_path}.pub"
  echo "---"

  # Now call core add
  _add_profile "$name" "$fullname" "$email" "$host" "$key_path"
}

# ── Subcommand implementations ────────────────────────────────────────────────

cmd_list() {
  local names
  names="$(list_profile_names)"
  if [[ -z "$names" ]]; then
    echo "No profiles configured."
    echo "Run 'git-profile add' to create one."
    return 0
  fi

  echo "Configured profiles:"
  echo ""
  local profile
  while IFS= read -r profile; do
    [[ -z "$profile" ]] && continue
    local name email host ssh_key
    name="$(get_profile_field "$profile" "name")"
    email="$(get_profile_field "$profile" "email")"
    host="$(get_profile_field "$profile" "host")"
    ssh_key="$(get_profile_field "$profile" "ssh_key")"
    echo "  [${profile}]"
    echo "    Name:  ${name}"
    echo "    Email: ${email}"
    echo "    Host:  ${host}"
    echo "    Key:   ${ssh_key}"
    echo ""
  done <<< "$names"
}

cmd_add() {
  echo ""
  echo "=== Add New Profile ==="
  echo ""

  # ── 1. Profile name ──────────────────────────────────────────────────────
  local name=""
  while true; do
    printf "Profile name (e.g., personal, work): "
    read -r name
    if ! validate_profile_name "$name" 2>/dev/null; then
      echo "Invalid profile name. Please try again." >&2
      continue
    fi
    # Check for existing profile
    local existing_names
    existing_names="$(list_profile_names)"
    if echo "$existing_names" | grep -qx "$name"; then
      printf "Profile '%s' already exists. Overwrite? [y/N] " "$name"
      read -r overwrite
      case "$overwrite" in
        [yY]*) break ;;
        *) echo "Aborted." >&2; return 1 ;;
      esac
    else
      break
    fi
  done

  # ── 2. User name ─────────────────────────────────────────────────────────
  local fullname=""
  while [[ -z "$fullname" ]]; do
    printf "User name: "
    read -r fullname
    if [[ -z "$fullname" ]]; then
      echo "Name cannot be empty." >&2
    fi
  done

  # ── 3. Email ─────────────────────────────────────────────────────────────
  local email=""
  while [[ -z "$email" ]]; do
    printf "Email: "
    read -r email
    if [[ -z "$email" ]]; then
      echo "Email cannot be empty." >&2
    fi
  done

  # ── 4. Host ───────────────────────────────────────────────────────────────
  local host=""
  while [[ -z "$host" ]]; do
    printf "Git platform host (e.g., github.com): "
    read -r host
    if [[ -z "$host" ]]; then
      echo "Host cannot be empty." >&2
    fi
  done

  # ── 5. SSH key: bind or skip ──────────────────────────────────────────────
  printf "需要绑定 SSH 密钥？[Y/n] "
  read -r need_key
  case "$need_key" in
    [nN]*)
      # 不绑定密钥
      _add_profile "$name" "$fullname" "$email" "$host" ""
      ;;
    *)
      # ── 5a. Generate new or use existing ─────────────────────────────────
      printf "Generate a new SSH key? [Y/n] "
      read -r gen_key
      case "$gen_key" in
        [nN]*)
          # Use existing key
          local key_path=""
          while [[ -z "$key_path" ]]; do
            printf "Path to existing SSH private key: "
            read -r key_path
            if [[ -z "$key_path" ]]; then
              echo "Key path cannot be empty." >&2
            elif [[ ! -f "$key_path" ]]; then
              echo "File not found: ${key_path}" >&2
              key_path=""
            fi
          done
          _add_profile "$name" "$fullname" "$email" "$host" "$key_path"
          ;;
        *)
          # Generate new key — ask for algorithm
          printf "Key algorithm [ed25519/rsa] (default: ed25519): "
          read -r algorithm
          algorithm="${algorithm:-ed25519}"
          _add_profile_with_keygen "$name" "$fullname" "$email" "$host" "$algorithm"
          ;;
      esac
      ;;
  esac

  echo ""
  echo "Profile '${name}' added successfully."
}

# _edit_profile: core edit logic
# Usage: _edit_profile <name> <new_name> <new_email> <new_host> <new_key>
# Pass empty string "" to keep the current value
_edit_profile() {
  local profile="$1" new_fullname="$2" new_email="$3" new_host="$4" new_key="$5"

  # Read current values
  local cur_name cur_email cur_host cur_key
  cur_name="$(get_profile_field "$profile" "name")"
  if [[ -z "$cur_name" ]]; then
    echo "git-profile: profile '${profile}' not found." >&2
    exit 1
  fi
  cur_email="$(get_profile_field "$profile" "email")"
  cur_host="$(get_profile_field "$profile" "host")"
  cur_key="$(get_profile_field "$profile" "ssh_key")"

  # Apply new values (keep existing if empty string passed)
  local final_name final_email final_host final_key
  final_name="${new_fullname:-$cur_name}"
  final_email="${new_email:-$cur_email}"
  final_host="${new_host:-$cur_host}"
  final_key="${new_key:-$cur_key}"

  # Rewrite profile section
  write_profile_section "$profile" "$final_name" "$final_email" "$final_host" "$final_key"

  # Update gitconfig.d fragment if it exists
  local fragment_file="${GITCONFIG_D}/${profile}"
  if [[ -f "$fragment_file" ]]; then
    local expanded_key
    expanded_key="${final_key/#\~/$HOME}"
    write_gitconfig_fragment "$profile" "$final_name" "$final_email" "$expanded_key"
  fi

  echo "Profile '${profile}' updated."
}

cmd_edit() {
  local profile_arg="${1:-}"

  if [[ -z "$profile_arg" ]]; then
    # Interactive: list and prompt for profile name
    local names
    names="$(list_profile_names)"
    if [[ -z "$names" ]]; then
      echo "git-profile: no profiles configured. Run 'git-profile add' first." >&2
      exit 1
    fi
    echo "Configured profiles:"
    local pname
    while IFS= read -r pname; do
      [[ -z "$pname" ]] && continue
      echo "  ${pname}"
    done <<< "$names"
    printf "Profile to edit: "
    read -r profile_arg
    if [[ -z "$profile_arg" ]]; then
      echo "Aborted." >&2
      return 1
    fi
  fi

  # Read current values to show as defaults
  local cur_name cur_email cur_host cur_key
  cur_name="$(get_profile_field "$profile_arg" "name")"
  if [[ -z "$cur_name" ]]; then
    echo "git-profile: profile '${profile_arg}' not found." >&2
    exit 1
  fi
  cur_email="$(get_profile_field "$profile_arg" "email")"
  cur_host="$(get_profile_field "$profile_arg" "host")"
  cur_key="$(get_profile_field "$profile_arg" "ssh_key")"

  echo "Editing profile '${profile_arg}' (press Enter to keep current value):"
  echo ""

  local new_name new_email new_host new_key
  printf "  Name [%s]: " "$cur_name"
  read -r new_name

  printf "  Email [%s]: " "$cur_email"
  read -r new_email

  printf "  Host [%s]: " "$cur_host"
  read -r new_host

  printf "  SSH Key [%s]: " "$cur_key"
  read -r new_key

  _edit_profile "$profile_arg" "$new_name" "$new_email" "$new_host" "$new_key"
}

# _remove_ssh_config_entries: remove SSH config block marked with # git-profile: <name>
_remove_ssh_config_entries() {
  local name="$1"
  local ssh_config="${HOME}/.ssh/config"
  [[ -f "$ssh_config" ]] || return 0

  local marker="# git-profile: ${name}"
  local tmp
  tmp="$(mktemp)"

  awk -v marker="$marker" '
    BEGIN { skip = 0 }
    {
      if ($0 == marker) {
        skip = 1
        next
      }
      # Stop skipping on next Host line (not the one we are removing)
      if (skip && /^Host / ) {
        skip = 0
      }
      if (!skip) print
    }
  ' "$ssh_config" > "$tmp"

  mv "$tmp" "$ssh_config"
}

# _remove_profile: core remove logic
# Usage: _remove_profile <name>
_remove_profile() {
  local name="$1"

  # Validate profile exists
  local p_name
  p_name="$(get_profile_field "$name" "name")"
  if [[ -z "$p_name" ]]; then
    echo "git-profile: profile '${name}' not found." >&2
    exit 1
  fi

  # IMPORTANT: Read p_key BEFORE deleting the section
  local p_key
  p_key="$(get_profile_field "$name" "ssh_key")"
  p_key="${p_key/#\~/$HOME}"

  # Find referencing rules (cascade delete) — use string accumulation for Bash 3.2 compat
  local referencing_rules=""
  local rname
  while IFS= read -r rname; do
    [[ -z "$rname" ]] && continue
    local rdir rprofile
    rprofile="$(get_rule_field "$rname" "profile")"
    if [[ "$rprofile" == "$name" ]]; then
      rdir="$(get_rule_field "$rname" "dir")"
      referencing_rules="${referencing_rules}${rname}:${rdir}
"
    fi
  done < <(list_rule_names)

  # If there are referencing rules, cascade-remove them
  if [[ -n "$referencing_rules" ]]; then
    local do_cascade="${GIT_PROFILE_AUTO_CONFIRM:-}"
    if [[ "$do_cascade" != "y" ]]; then
      echo "Profile '${name}' is referenced by these rules:"
      local entry
      while IFS= read -r entry; do
        [[ -z "$entry" ]] && continue
        echo "  - ${entry%%:*}"
      done <<< "$referencing_rules"
      printf "Delete these rules as well? [Y/n]: "
      read -r answer
      case "$answer" in
        [nN]*) do_cascade="n" ;;
        *)     do_cascade="y" ;;
      esac
    fi

    if [[ "$do_cascade" == "y" ]]; then
      local entry
      while IFS= read -r entry; do
        [[ -z "$entry" ]] && continue
        local rn rdir
        rn="${entry%%:*}"
        rdir="${entry#*:}"
        # Delete rule section
        delete_config_section "rule:${rn}"
        # Remove includeIf from global gitconfig
        if [[ -n "$rdir" ]]; then
          git config --global --unset "includeIf.gitdir:${rdir}.path" 2>/dev/null || true
        fi
      done <<< "$referencing_rules"
    fi
  fi

  # Delete the profile section
  delete_config_section "$name"

  # Remove gitconfig.d fragment if it exists
  local fragment_file="${GITCONFIG_D}/${name}"
  if [[ -f "$fragment_file" ]]; then
    local do_remove="${GIT_PROFILE_AUTO_CONFIRM:-}"
    if [[ "$do_remove" != "y" ]]; then
      printf "Delete gitconfig fragment '%s'? [y/N] " "$fragment_file"
      read -r answer
      case "$answer" in
        [nN]*) do_remove="n" ;;
        *)     do_remove="y" ;;
      esac
    fi
    if [[ "$do_remove" == "y" ]]; then
      rm -f "$fragment_file"
    fi
  fi

  # Clean up SSH keys if they exist
  if [[ -n "$p_key" && -f "$p_key" ]]; then
    local do_delete_key="${GIT_PROFILE_AUTO_CONFIRM:-}"
    if [[ "$do_delete_key" != "y" ]]; then
      printf "Delete SSH key '%s'? [y/N] " "$p_key"
      read -r answer
      case "$answer" in
        [yY]*) do_delete_key="y" ;;
        *)     do_delete_key="n" ;;
      esac
    fi
    if [[ "$do_delete_key" == "y" ]]; then
      rm -f "$p_key" "${p_key}.pub" 2>/dev/null || true
    fi
  fi

  # Remove SSH config entries
  _remove_ssh_config_entries "$name"

  echo "Profile '${name}' removed."
}

cmd_remove() {
  local profile_arg="${1:-}"

  if [[ -z "$profile_arg" ]]; then
    # Interactive: list profiles and prompt
    local names
    names="$(list_profile_names)"
    if [[ -z "$names" ]]; then
      echo "git-profile: no profiles configured." >&2
      return 0
    fi
    echo "Configured profiles:"
    local pname
    while IFS= read -r pname; do
      [[ -z "$pname" ]] && continue
      echo "  ${pname}"
    done <<< "$names"
    printf "Profile to remove: "
    read -r profile_arg
    if [[ -z "$profile_arg" ]]; then
      echo "Aborted." >&2
      return 1
    fi
  fi

  _remove_profile "$profile_arg"
}

cmd_use_clear() {
  # Ensure we're inside a git repo
  if ! git rev-parse --is-inside-work-tree &>/dev/null; then
    echo "git-profile: not inside a git repository." >&2
    exit 1
  fi

  # Check that a profile override exists
  local current_profile
  current_profile="$(git config --local gitProfile.name 2>/dev/null || true)"
  if [[ -z "$current_profile" ]]; then
    echo "git-profile: no override to clear in this repository." >&2
    return 0
  fi

  # Restore or unset user.name
  local backup_name
  backup_name="$(git config --local gitProfile.backup.userName 2>/dev/null || true)"
  if [[ -n "$backup_name" ]]; then
    git config --local user.name "$backup_name"
  else
    git config --local --unset user.name 2>/dev/null || true
  fi

  # Restore or unset user.email
  local backup_email
  backup_email="$(git config --local gitProfile.backup.userEmail 2>/dev/null || true)"
  if [[ -n "$backup_email" ]]; then
    git config --local user.email "$backup_email"
  else
    git config --local --unset user.email 2>/dev/null || true
  fi

  # Restore or unset core.sshCommand
  local backup_ssh
  backup_ssh="$(git config --local gitProfile.backup.sshCommand 2>/dev/null || true)"
  if [[ -n "$backup_ssh" ]]; then
    git config --local core.sshCommand "$backup_ssh"
  else
    git config --local --unset core.sshCommand 2>/dev/null || true
  fi

  # Remove gitProfile and gitProfile "backup" sections
  git config --local --remove-section gitProfile 2>/dev/null || true
  git config --local --remove-section 'gitProfile "backup"' 2>/dev/null || true

  echo "Cleared profile override for this repository."
  echo ""
  echo "Effective config:"
  echo "  user.name  = $(git config user.name 2>/dev/null || echo '(not set)')"
  echo "  user.email = $(git config user.email 2>/dev/null || echo '(not set)')"
}

cmd_use() {
  local profile_arg="${1:-}"

  # Handle --clear flag
  if [[ "$profile_arg" == "--clear" ]]; then
    cmd_use_clear
    return
  fi

  # Ensure we're inside a git repo
  if ! git rev-parse --is-inside-work-tree &>/dev/null; then
    echo "git-profile: not inside a git repository." >&2
    exit 1
  fi

  # If no profile name given, list profiles for selection
  if [[ -z "$profile_arg" ]]; then
    local names
    names="$(list_profile_names)"
    if [[ -z "$names" ]]; then
      echo "git-profile: no profiles configured. Run 'git-profile add' first." >&2
      exit 1
    fi
    echo "Available profiles:"
    local i=1
    local pname
    while IFS= read -r pname; do
      [[ -z "$pname" ]] && continue
      echo "  $i) $pname"
      i=$((i + 1))
    done <<< "$names"
    printf "Select profile: "
    read -r selection
    i=1
    while IFS= read -r pname; do
      [[ -z "$pname" ]] && continue
      if [[ "$i" == "$selection" || "$pname" == "$selection" ]]; then
        profile_arg="$pname"
        break
      fi
      i=$((i + 1))
    done <<< "$names"
    if [[ -z "$profile_arg" ]]; then
      echo "git-profile: invalid selection." >&2
      exit 1
    fi
  fi

  # Validate profile exists in config
  local p_name p_email p_host p_key
  p_name="$(get_profile_field "$profile_arg" "name")"
  if [[ -z "$p_name" ]]; then
    echo "git-profile: profile '${profile_arg}' not found." >&2
    exit 1
  fi
  p_email="$(get_profile_field "$profile_arg" "email")"
  p_host="$(get_profile_field "$profile_arg" "host")"
  p_key="$(get_profile_field "$profile_arg" "ssh_key")"

  # Expand ~ in key path
  p_key="${p_key/#\~/$HOME}"

  # Check if overriding an existing rule
  local effective_profile local_profile
  effective_profile="$(git config gitProfile.name 2>/dev/null || true)"
  local_profile="$(git config --local gitProfile.name 2>/dev/null || true)"
  if [[ -n "$effective_profile" && -z "$local_profile" ]]; then
    echo "Warning: overriding rule-applied profile '${effective_profile}' with '${profile_arg}'." >&2
  fi

  # First-use backup (write-once): only when local gitProfile.name is EMPTY
  if [[ -z "$local_profile" ]]; then
    local orig_name orig_email orig_ssh
    orig_name="$(git config --local user.name 2>/dev/null || true)"
    orig_email="$(git config --local user.email 2>/dev/null || true)"
    orig_ssh="$(git config --local core.sshCommand 2>/dev/null || true)"

    [[ -n "$orig_name" ]]  && git config --local gitProfile.backup.userName "$orig_name"
    [[ -n "$orig_email" ]] && git config --local gitProfile.backup.userEmail "$orig_email"
    [[ -n "$orig_ssh" ]]   && git config --local gitProfile.backup.sshCommand "$orig_ssh"
  fi

  # Apply profile
  git config --local gitProfile.name "$profile_arg"
  git config --local user.name "$p_name"
  git config --local user.email "$p_email"
  # 无密钥时不写 core.sshCommand，保留用户已有配置（或不设置）
  if [[ -n "$p_key" ]]; then
    git config --local core.sshCommand "ssh -i \"${p_key}\" -o IdentitiesOnly=yes"
  fi

  echo "Switched to profile '${profile_arg}' in this repository."
  echo "  Name:  ${p_name}"
  echo "  Email: ${p_email}"
  [[ -n "$p_key" ]] && echo "  Key:   ${p_key}"

  # Check for HTTPS remotes and offer to convert
  local https_remotes=""
  local https_count=0
  local rname rurl
  while IFS= read -r line; do
    [[ -z "$line" ]] && continue
    rname="$(echo "$line" | awk '{print $1}')"
    rurl="$(echo "$line" | awk '{print $2}')"
    local rdir
    rdir="$(echo "$line" | awk '{print $3}')"
    [[ "$rdir" != "(fetch)" ]] && continue
    if [[ "$rurl" == https://* ]]; then
      https_remotes="${https_remotes}${rname} ${rurl}"$'\n'
      https_count=$((https_count + 1))
    fi
  done < <(git remote -v 2>/dev/null)

  if [[ "$https_count" -gt 0 ]]; then
    echo ""
    echo "Warning: the following remotes use HTTPS — SSH key will not be used:"
    local entry
    while IFS= read -r entry; do
      [[ -z "$entry" ]] && continue
      rname="${entry%% *}"
      rurl="${entry#* }"
      echo "  ${rname}: ${rurl}"
    done <<< "$https_remotes"

    local ssh_host
    ssh_host="$(profile_ssh_host "$profile_arg")"

    local do_convert="${GIT_PROFILE_AUTO_CONFIRM:-}"
    if [[ "$do_convert" != "y" && "$do_convert" != "n" ]]; then
      printf "Convert to SSH? [y/N] "
      read -r answer
      case "$answer" in
        [yY]*) do_convert="y" ;;
        *)     do_convert="n" ;;
      esac
    fi

    if [[ "$do_convert" == "y" ]]; then
      while IFS= read -r entry; do
        [[ -z "$entry" ]] && continue
        rname="${entry%% *}"
        rurl="${entry#* }"
        local new_url
        new_url="$(url_https_to_ssh "$rurl" "$ssh_host")"
        git remote set-url "$rname" "$new_url"
        echo "  ${rname}: ${rurl} → ${new_url}"
      done <<< "$https_remotes"
    fi
  fi
}

cmd_current() {
  # Ensure we're inside a git repo
  if ! git rev-parse --is-inside-work-tree &>/dev/null; then
    echo "git-profile: not inside a git repository." >&2
    exit 1
  fi

  # Read effective profile (includes includeIf) and local profile
  local effective_profile local_profile
  effective_profile="$(git config gitProfile.name 2>/dev/null || true)"
  local_profile="$(git config --local gitProfile.name 2>/dev/null || true)"

  local profile_name="" source_label="" note=""

  if [[ -n "$local_profile" ]]; then
    # Profile set by `use` command (project config)
    profile_name="$local_profile"
    source_label="project config"
    # Check if it's also overriding a rule
    if [[ -n "$effective_profile" && "$effective_profile" != "$local_profile" ]]; then
      note=" (overriding rule profile '${effective_profile}')"
    fi
  elif [[ -n "$effective_profile" ]]; then
    # Profile from includeIf rule
    profile_name="$effective_profile"
    source_label="rule (includeIf)"
  else
    # No gitProfile.name set — try to infer from user.name + user.email
    local cur_name_try cur_email_try
    cur_name_try="$(git config user.name 2>/dev/null || true)"
    cur_email_try="$(git config user.email 2>/dev/null || true)"

    if [[ -n "$cur_name_try" || -n "$cur_email_try" ]]; then
      # Try matching against known profiles
      local pname matched_profile=""
      while IFS= read -r pname; do
        [[ -z "$pname" ]] && continue
        local pf_name pf_email
        pf_name="$(get_profile_field "$pname" "name")"
        pf_email="$(get_profile_field "$pname" "email")"
        if [[ "$pf_name" == "$cur_name_try" && "$pf_email" == "$cur_email_try" ]]; then
          matched_profile="$pname"
          break
        fi
      done < <(list_profile_names)

      if [[ -n "$matched_profile" ]]; then
        profile_name="$matched_profile"
        source_label="inferred"
      fi
    fi
  fi

  # Display results
  if [[ -n "$profile_name" ]]; then
    local p_name p_email p_host p_key
    p_name="$(get_profile_field "$profile_name" "name")"
    p_email="$(get_profile_field "$profile_name" "email")"
    p_host="$(get_profile_field "$profile_name" "host")"
    p_key="$(get_profile_field "$profile_name" "ssh_key")"

    echo "Current Git Profile: ${profile_name}${note}"
    echo "  Name:   ${p_name}"
    echo "  Email:  ${p_email}"
    [[ -n "$p_host" ]] && echo "  Host:   ${p_host}"
    [[ -n "$p_key" ]]  && echo "  Key:    ${p_key}"
    echo "  Source: ${source_label}"
  else
    local cur_name cur_email
    cur_name="$(git config user.name 2>/dev/null || echo '(not set)')"
    cur_email="$(git config user.email 2>/dev/null || echo '(not set)')"

    echo "Current Git identity:"
    echo "  user.name  = ${cur_name}"
    echo "  user.email = ${cur_email}"
    echo ""
    echo "  Profile    = (not set)"
  fi
}

# ── Remote URL management ─────────────────────────────────────────────────────

require_git_repo() {
  if ! git rev-parse --is-inside-work-tree &>/dev/null; then
    echo "git-profile: not inside a git repository." >&2
    exit 1
  fi
}

remote_exists() {
  local remote_name="$1"
  git remote get-url "$remote_name" &>/dev/null
}

list_fetch_remotes() {
  git remote -v 2>/dev/null | awk '$3 == "(fetch)" { print $1 "\t" $2 }'
}

cmd_remote_show() {
  require_git_repo

  local profile_name
  profile_name="$(git config gitProfile.name 2>/dev/null || true)"

  echo "Remote URLs:"
  if [[ -n "$profile_name" ]]; then
    echo "  (active profile: ${profile_name})"
  fi
  echo ""

  local found=0
  local remote_name remote_url proto_label
  while IFS=$'\t' read -r remote_name remote_url; do
    if [[ "$remote_url" == https://* ]]; then
      proto_label="[HTTPS]"
    elif [[ "$remote_url" == git@* ]]; then
      proto_label="[SSH]"
    elif [[ "$remote_url" == ssh://* ]]; then
      proto_label="[SSH]"
    else
      proto_label="[OTHER]"
    fi

    echo "  ${remote_name}  ${remote_url}  ${proto_label}"
    found=1
  done < <(list_fetch_remotes)

  if [[ "$found" -eq 0 ]]; then
    echo "  (no remotes configured)"
  fi
}

cmd_remote_set() {
  require_git_repo

  local target_remote new_url
  case "$#" in
    1)
      target_remote="origin"
      new_url="$1"
      ;;
    2)
      target_remote="$1"
      new_url="$2"
      ;;
    *)
      echo "Usage: git-profile remote set [remote-name] <url>" >&2
      exit 1
      ;;
  esac

  if ! remote_exists "$target_remote"; then
    echo "git-profile: remote '${target_remote}' not found." >&2
    exit 1
  fi

  git remote set-url "$target_remote" "$new_url"
  echo "Updated remote '${target_remote}' to ${new_url}"
}

cmd_remote_set_ssh() {
  local target_remote="${1:-}"

  require_git_repo

  if [[ -n "$target_remote" ]] && ! remote_exists "$target_remote"; then
    echo "git-profile: remote '${target_remote}' not found." >&2
    exit 1
  fi

  # Get current profile
  local profile_name
  profile_name="$(git config gitProfile.name 2>/dev/null || true)"
  if [[ -z "$profile_name" ]]; then
    echo "git-profile: no active profile. Run 'git-profile use <profile>' first." >&2
    exit 1
  fi

  # Get SSH host for this profile
  local ssh_host
  ssh_host="$(profile_ssh_host "$profile_name")"
  if [[ -z "$ssh_host" ]]; then
    echo "git-profile: cannot determine SSH host for profile '${profile_name}'." >&2
    exit 1
  fi

  # Collect HTTPS remotes to convert
  local remotes_to_convert=""
  local count=0
  local remote_name remote_url
  while IFS=$'\t' read -r remote_name remote_url; do
    # Filter by target remote if specified
    if [[ -n "$target_remote" && "$remote_name" != "$target_remote" ]]; then
      continue
    fi

    if [[ "$remote_url" == https://* ]]; then
      remotes_to_convert="${remotes_to_convert}${remote_name}"$'\t'"${remote_url}"$'\n'
      count=$((count + 1))
    elif [[ "$remote_url" == ssh://* ]]; then
      echo "Skipping '${remote_name}': unsupported URL format (ssh://)" >&2
    fi
  done < <(list_fetch_remotes)

  if [[ "$count" -eq 0 ]]; then
    echo "All remotes are already using SSH."
    return 0
  fi

  # Preview
  echo "Converting remote URLs to SSH (profile: ${profile_name}, host: ${ssh_host}):"
  local new_url
  while IFS= read -r entry; do
    [[ -z "$entry" ]] && continue
    IFS=$'\t' read -r remote_name remote_url <<< "$entry"
    new_url="$(url_https_to_ssh "$remote_url" "$ssh_host")"
    echo "  ${remote_name}: ${remote_url} → ${new_url}"
  done <<< "$remotes_to_convert"

  # Confirm
  local do_convert="${GIT_PROFILE_AUTO_CONFIRM:-}"
  if [[ "$do_convert" != "y" ]]; then
    printf "Proceed? [y/N] "
    read -r answer
    case "$answer" in
      [yY]*) do_convert="y" ;;
      *)     echo "Aborted."; return 1 ;;
    esac
  fi

  # Execute
  while IFS= read -r entry; do
    [[ -z "$entry" ]] && continue
    IFS=$'\t' read -r remote_name remote_url <<< "$entry"
    new_url="$(url_https_to_ssh "$remote_url" "$ssh_host")"
    git remote set-url "$remote_name" "$new_url"
  done <<< "$remotes_to_convert"

  echo "Done."
}

cmd_remote_set_https() {
  local target_remote="${1:-}"

  require_git_repo

  if [[ -n "$target_remote" ]] && ! remote_exists "$target_remote"; then
    echo "git-profile: remote '${target_remote}' not found." >&2
    exit 1
  fi

  # Get current profile
  local profile_name
  profile_name="$(git config gitProfile.name 2>/dev/null || true)"
  if [[ -z "$profile_name" ]]; then
    echo "git-profile: no active profile. Run 'git-profile use <profile>' first." >&2
