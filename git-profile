# ── Rule helpers ──────────────────────────────────────────────────────────────

# normalize_path: expand ~, make absolute, use cd+pwd if dir exists (fallback: realpath), ensure trailing /
normalize_path() {
  local path="$1"

  # Expand leading ~
  path="${path/#\~/$HOME}"

  # If directory exists, resolve canonically using cd+pwd (avoids symlink resolution
  # issues where realpath may return a different symlink-resolved path than mktemp -d)
  if [[ -d "$path" ]]; then
    path="$(cd "$path" && pwd)" || {
      if command -v realpath &>/dev/null; then
        path="$(realpath "$path" 2>/dev/null)" || true
      fi
    }
  else
    # Directory does not exist — warn and keep as-is (make absolute if relative)
    echo "git-profile: warning: directory '${path}' does not exist." >&2
    if [[ "$path" != /* ]]; then
      path="$(pwd)/${path}"
    fi
  fi

  # Ensure trailing /
  path="${path%/}/"
  echo "$path"
}

# write_gitconfig_fragment: write a gitconfig.d/<profile> fragment
# Usage: write_gitconfig_fragment <profile_name> <fullname> <email> <key_path>
write_gitconfig_fragment() {
  local profile="$1" fullname="$2" email="$3" key_path="$4"
  local fragment_file="${GITCONFIG_D}/${profile}"

  mkdir -p "$GITCONFIG_D"

  if [[ -n "$key_path" ]]; then
    cat > "$fragment_file" <<EOF
[gitProfile]
  name = ${profile}
[user]
  name = ${fullname}
  email = ${email}
[core]
  sshCommand = ssh -i "${key_path}" -o IdentitiesOnly=yes
EOF
  else
    # 无密钥：不写 sshCommand，仅覆盖用户身份
    cat > "$fragment_file" <<EOF
[gitProfile]
  name = ${profile}
[user]
  name = ${fullname}
  email = ${email}
EOF
  fi
}

# _rule_add: core rule add logic
# Usage: _rule_add <rule_name> <dir> <profile>
_rule_add() {
  local rule_name="$1" dir="$2" profile="$3"

  # Validate profile exists
  local p_name
  p_name="$(get_profile_field "$profile" "name")"
  if [[ -z "$p_name" ]]; then
    echo "git-profile: profile '${profile}' not found." >&2
    exit 1
  fi

  # Normalize the path
  local norm_dir
  norm_dir="$(normalize_path "$dir")"

  # Write rule section to config
  write_rule_section "$rule_name" "$norm_dir" "$profile"

  # Generate gitconfig.d fragment
  local p_email p_key
  p_email="$(get_profile_field "$profile" "email")"
  p_key="$(get_profile_field "$profile" "ssh_key")"
  # Expand ~ in key path
  p_key="${p_key/#\~/$HOME}"

  write_gitconfig_fragment "$profile" "$p_name" "$p_email" "$p_key"

  # Write includeIf to global gitconfig
  local fragment_file="${GITCONFIG_D}/${profile}"
  git config --global "includeIf.gitdir:${norm_dir}.path" "$fragment_file"

  echo ""
  echo "Rule '${rule_name}' added."
  echo "  Directory: ${norm_dir}"
  echo "  Profile:   ${profile}"
}

# ── Rule subcommands ──────────────────────────────────────────────────────────

# _rule_remove: core rule remove logic
# Usage: _rule_remove <rule_name>
_rule_remove() {
  local rule_name="$1"

  # Read rule data before deleting
  local rule_dir rule_profile
  rule_dir="$(get_rule_field "$rule_name" "dir")"
  rule_profile="$(get_rule_field "$rule_name" "profile")"

  if [[ -z "$rule_dir" && -z "$rule_profile" ]]; then
    echo "git-profile: rule '${rule_name}' not found." >&2
    exit 1
  fi

  # Delete the rule section from config
  delete_config_section "rule:${rule_name}"

  # Remove the includeIf from global gitconfig
  if [[ -n "$rule_dir" ]]; then
    git config --global --unset "includeIf.gitdir:${rule_dir}.path" 2>/dev/null || true
  fi

  # Check if the fragment is still needed by other rules referencing the same profile
  local still_needed="no"
  local rname
  while IFS= read -r rname; do
    [[ -z "$rname" ]] && continue
    local other_profile
    other_profile="$(get_rule_field "$rname" "profile")"
    if [[ "$other_profile" == "$rule_profile" ]]; then
      still_needed="yes"
      break
    fi
  done < <(list_rule_names)

  # Remove fragment if no other rule references this profile
  if [[ "$still_needed" == "no" && -n "$rule_profile" ]]; then
    local fragment_file="${GITCONFIG_D}/${rule_profile}"
    if [[ -f "$fragment_file" ]]; then
      rm -f "$fragment_file"
    fi
  fi

  echo "Rule '${rule_name}' removed."
}

cmd_rule_list() {
  local names
  names="$(list_rule_names)"
  if [[ -z "$names" ]]; then
    echo "No rules configured."
    return 0
  fi

  echo "Directory rules:"
  echo ""
  local rule
  while IFS= read -r rule; do
    [[ -z "$rule" ]] && continue
    local dir profile
    dir="$(get_rule_field "$rule" "dir")"
    profile="$(get_rule_field "$rule" "profile")"
    echo "  [${rule}]"
    echo "    Directory: ${dir}"
    echo "    Profile:   ${profile}"
    echo ""
  done <<< "$names"
}

cmd_rule_add() {
  # ── 1. Rule name ──────────────────────────────────────────────────────────
  local rule_name=""
  while [[ -z "$rule_name" ]]; do
    printf "Rule name (letters, digits, hyphens, underscores): "
    read -r rule_name
    if [[ -z "$rule_name" ]]; then
      echo "Rule name cannot be empty." >&2
    fi
  done

  # ── 2. Directory ──────────────────────────────────────────────────────────
  local dir=""
  while [[ -z "$dir" ]]; do
    printf "Directory to match (e.g. ~/projects/work/): "
    read -r dir
    if [[ -z "$dir" ]]; then
      echo "Directory cannot be empty." >&2
    fi
  done

  # ── 3. Profile ────────────────────────────────────────────────────────────
  local profile=""
  while [[ -z "$profile" ]]; do
    printf "Profile to apply: "
    read -r profile
    if [[ -z "$profile" ]]; then
      echo "Profile cannot be empty." >&2
    fi
  done

  _rule_add "$rule_name" "$dir" "$profile"
}

cmd_rule_remove() {
  local rule_name="${1:-}"
  if [[ -z "$rule_name" ]]; then
    # Interactive: list rules and prompt
    local names
    names="$(list_rule_names)"
    if [[ -z "$names" ]]; then
      echo "No rules configured." >&2
      return 0
    fi
    echo "Configured rules:"
    local rname
    while IFS= read -r rname; do
      [[ -z "$rname" ]] && continue
      echo "  ${rname}"
    done <<< "$names"
    printf "Rule name to remove: "
    read -r rule_name
    if [[ -z "$rule_name" ]]; then
      echo "Aborted." >&2
      return 1
    fi
  fi

  _rule_remove "$rule_name"
}

cmd_rule() {
  local sub="${1:-}"
  case "$sub" in
    add)    shift; cmd_rule_add "$@" ;;
    list)   cmd_rule_list ;;
    remove) shift; cmd_rule_remove "$@" ;;
    "")     interactive_rule_menu ;;
    *)
      echo "git-profile rule: unknown subcommand '${sub}'" >&2
      echo "Usage: git-profile rule [add|list|remove]" >&2
      exit 1
      ;;
  esac
}

interactive_menu() {
  while true; do
    echo ""
    echo "Git Profile Manager"
    echo "━━━━━━━━━━━━━━━━━━━━━"
    echo "1) 添加新身份"
    echo "2) 修改身份"
    echo "3) 查看所有身份"
    echo "4) 切换当前项目身份"
    echo "5) 撤销身份覆盖（恢复原始配置）"
    echo "6) 管理目录规则"
    echo "7) 查看当前身份"
    echo "8) 删除身份"
    echo "9) 管理远程 URL"
    echo "0) 退出"
    echo ""
    read -rp "请选择: " choice

    case "$choice" in
      1) cmd_add ;;
      2) cmd_edit ;;
      3) cmd_list ;;
      4) cmd_use ;;
      5) cmd_use --clear ;;
      6) interactive_rule_menu ;;
      7) cmd_current ;;
      8) cmd_remove ;;
      9) interactive_remote_menu ;;
      0) echo "Bye."; return ;;
      *) echo "Invalid choice." ;;
    esac
  done
}

interactive_remote_menu() {
  echo ""
  echo "Remote URL Management"
  echo "━━━━━━━━━━━━━━━━━━━━━━"
  echo "1) 查看远程 URL"
  echo "2) 设置远程 URL"
  echo "3) 转换为 SSH"
  echo "4) 转换为 HTTPS"
  echo "0) 返回"
  echo ""
  read -rp "请选择: " choice
  case "$choice" in
    1) cmd_remote_show ;;
    2)
      local remote_name new_url
      read -rp "Remote 名称（默认: origin）: " remote_name
      [[ -n "$remote_name" ]] || remote_name="origin"
      read -rp "新的 remote URL: " new_url
      cmd_remote_set "$remote_name" "$new_url"
      ;;
    3) cmd_remote_set_ssh ;;
    4) cmd_remote_set_https ;;
    0) return ;;
    *) echo "Invalid choice." ;;
  esac
}

interactive_rule_menu() {
  echo ""
  echo "Directory Rules"
  echo "━━━━━━━━━━━━━━━━"
  echo "1) 添加规则"
