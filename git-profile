cmd_list() {
  echo "git-profile list: not yet implemented." >&2
}

cmd_add() {
  echo "git-profile add: not yet implemented." >&2
}

cmd_edit() {
  echo "git-profile edit: not yet implemented." >&2
}

cmd_remove() {
  echo "git-profile remove: not yet implemented." >&2
}

cmd_use() {
  echo "git-profile use: not yet implemented." >&2
}

cmd_show() {
  echo "git-profile show: not yet implemented." >&2
}

cmd_install() {
  echo "git-profile install: not yet implemented." >&2
}

cmd_check() {
  echo "git-profile check: not yet implemented." >&2
}

cmd_rule() {
  echo "git-profile rule: not yet implemented." >&2
}

interactive_rule_menu() {
  echo "git-profile rule: interactive menu not yet implemented." >&2
}

# ── Main dispatcher ───────────────────────────────────────────────────────────
main() {
  check_dependencies

  local cmd="${1:-}"

  case "$cmd" in
    --version|-V)
      echo "git-profile version ${VERSION}"
      ;;
    --help|-h|help)
      show_help
      ;;
    list)
      shift
      cmd_list "$@"
      ;;
    add)
      shift
      cmd_add "$@"
      ;;
    edit)
      shift
      cmd_edit "$@"
      ;;
    remove|rm)
      shift
      cmd_remove "$@"
      ;;
    use)
      shift
      cmd_use "$@"
      ;;
    show)
      shift
      cmd_show "$@"
      ;;
    install)
      shift
      cmd_install "$@"
      ;;
    check)
      shift
      cmd_check "$@"
      ;;
    rule)
      shift
      cmd_rule "$@"
      ;;
    "")
      show_help
      exit 0
      ;;
    *)
      echo "git-profile: unknown subcommand '${cmd}'" >&2
      echo "Run 'git-profile --help' for usage." >&2
      exit 1
      ;;
  esac
}

main "$@"
