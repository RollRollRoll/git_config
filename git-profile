  fi

  # Collect SSH remotes to convert
  local remotes_to_convert=""
  local count=0
  local remote_name remote_url
  while IFS=$'\t' read -r remote_name remote_url; do
    # Filter by target remote if specified
    if [[ -n "$target_remote" && "$remote_name" != "$target_remote" ]]; then
      continue
    fi

    if [[ "$remote_url" == git@* ]]; then
      remotes_to_convert="${remotes_to_convert}${remote_name}"$'\t'"${remote_url}"$'\n'
      count=$((count + 1))
    elif [[ "$remote_url" == ssh://* ]]; then
      echo "Skipping '${remote_name}': unsupported URL format (ssh://)" >&2
    fi
  done < <(list_fetch_remotes)

  if [[ "$count" -eq 0 ]]; then
    echo "All remotes are already using HTTPS."
    return 0
  fi

  # Preview
  echo "Converting remote URLs to HTTPS (profile: ${profile_name}, host: ${real_host}):"
  local new_url
  while IFS= read -r entry; do
    [[ -z "$entry" ]] && continue
    IFS=$'\t' read -r remote_name remote_url <<< "$entry"
    new_url="$(url_ssh_to_https "$remote_url" "$real_host")"
    echo "  ${remote_name}: ${remote_url} → ${new_url}"
  done <<< "$remotes_to_convert"

  # Confirm
  local do_convert="${GIT_PROFILE_AUTO_CONFIRM:-}"
  if [[ "$do_convert" != "y" ]]; then
    printf "Proceed? [y/N] "
    read -r answer
    case "$answer" in
      [yY]*) do_convert="y" ;;
      *)     echo "Aborted."; return 1 ;;
    esac
  fi

  # Execute
  while IFS= read -r entry; do
    [[ -z "$entry" ]] && continue
    IFS=$'\t' read -r remote_name remote_url <<< "$entry"
    new_url="$(url_ssh_to_https "$remote_url" "$real_host")"
    git remote set-url "$remote_name" "$new_url"
  done <<< "$remotes_to_convert"

  echo "Done."
}

cmd_remote() {
  local sub="${1:-}"
  case "$sub" in
    show|"")   cmd_remote_show ;;
    set)       shift; cmd_remote_set "$@" ;;
    set-ssh)   shift; cmd_remote_set_ssh "$@" ;;
    set-https) shift; cmd_remote_set_https "$@" ;;
    *)         echo "Usage: git-profile remote [show|set|set-ssh|set-https]" >&2; exit 1 ;;
  esac
}

