#!/usr/bin/env bash
# git-profile — manage per-context Git identities
set -euo pipefail

VERSION="0.1.0"

# ── Environment-overridable config paths ─────────────────────────────────────
CONF_FILE="${CONF_FILE:-${HOME}/.git-profiles.conf}"
GITCONFIG_D="${GITCONFIG_D:-${HOME}/.gitconfig.d}"

# ── Utility: resolve a path with realpath fallback ───────────────────────────
resolve_path() {
  local path="$1"
  if command -v realpath &>/dev/null; then
    realpath "$path" 2>/dev/null || echo "$path"
  else
    # Bash 3.2 compatible fallback
    local dir base
    dir="$(cd "$(dirname "$path")" 2>/dev/null && pwd)" || { echo "$path"; return; }
    base="$(basename "$path")"
    echo "${dir}/${base}"
  fi
}

# ── Dependency check (Bash 3.2 compatible, no associative arrays) ─────────────
check_dependencies() {
  local missing=""
  local deps="git ssh-keygen awk sed"
  local dep
  for dep in $deps; do
    if ! command -v "$dep" &>/dev/null; then
      missing="${missing} ${dep}"
    fi
  done
  if [[ -n "$missing" ]]; then
    echo "git-profile: missing required dependencies:${missing}" >&2
    echo "Please install the missing tools and try again." >&2
    exit 1
  fi
}

# ── Help text ─────────────────────────────────────────────────────────────────
show_help() {
  cat <<EOF
Usage: git-profile <subcommand> [options]

Manage per-context Git identities via profiles.

Subcommands:
  list                     List all configured profiles
  add                      Add or update a profile (interactive)
  edit <profile>           Edit an existing profile
  remove <profile>         Remove a profile
  use <profile>            Apply a profile to the current repository
  show [profile]           Show profile details
  rule [add|list|remove]   Manage auto-apply rules
  install                  Install shell integration and SSH config
  check                    Check current repository's active profile

Options:
  --help       Show this help message
  --version    Show version information

Config file: ${CONF_FILE}
Fragments:   ${GITCONFIG_D}/

Examples:
  git-profile add
  git-profile list
  git-profile use personal
  git-profile rule add
  git-profile rule list
EOF
}

# ── INI config parser ─────────────────────────────────────────────────────────
# Reads CONF_FILE and emits lines of two forms:
#   PROFILE:name:key=value
#   RULE:rulename:key=value
parse_config() {
  local conf="${1:-$CONF_FILE}"
  [[ -f "$conf" ]] || return 0

  local current_type=""   # "PROFILE" or "RULE"
  local current_name=""

  while IFS= read -r line || [[ -n "$line" ]]; do
    # Strip leading/trailing whitespace
    line="${line#"${line%%[![:space:]]*}"}"
    line="${line%"${line##*[![:space:]]}"}"

    # Skip blank lines and comments
    [[ -z "$line" || "$line" == \#* ]] && continue

    # Section header: [rule "name"] or [name]
    if [[ "$line" =~ ^\[rule[[:space:]]\"([^\"]+)\"\]$ ]]; then
      current_type="RULE"
      current_name="${BASH_REMATCH[1]}"
      continue
    fi

    if [[ "$line" =~ ^\[([a-zA-Z0-9_-]+)\]$ ]]; then
      current_type="PROFILE"
      current_name="${BASH_REMATCH[1]}"
      continue
    fi

    # Key = value line (use (.*)$ to allow empty values)
    if [[ "$line" =~ ^([a-zA-Z_][a-zA-Z0-9_]*)[[:space:]]*=[[:space:]](.*)$ ]]; then
      local key="${BASH_REMATCH[1]}"
      local val="${BASH_REMATCH[2]}"
      if [[ -n "$current_type" && -n "$current_name" ]]; then
        echo "${current_type}:${current_name}:${key}=${val}"
      fi
    fi
  done < "$conf"
}

# Get a specific field from a profile
get_profile_field() {
  local profile="$1" field="$2"
  local prefix="PROFILE:${profile}:${field}="
  local parsed
  parsed="$(parse_config)"
  local line
  while IFS= read -r line; do
    if [[ "$line" == "${prefix}"* ]]; then
      echo "${line#${prefix}}"
      return 0
    fi
  done <<< "$parsed"
}

# List all profile names
list_profile_names() {
  local parsed
  parsed="$(parse_config)"
  local line seen=""
  while IFS= read -r line; do
    if [[ "$line" == PROFILE:* ]]; then
      local rest="${line#PROFILE:}"
      local pname="${rest%%:*}"
      # Deduplicate without sort -u to avoid SIGPIPE
      if [[ "$seen" != *"|${pname}|"* ]]; then
        seen="${seen}|${pname}|"
        echo "$pname"
      fi
    fi
  done <<< "$parsed"
}

# List all rule names
list_rule_names() {
  local parsed
  parsed="$(parse_config)"
  local line seen=""
  while IFS= read -r line; do
    if [[ "$line" == RULE:* ]]; then
      local rest="${line#RULE:}"
      local rname="${rest%%:*}"
      # Deduplicate without sort -u to avoid SIGPIPE
      if [[ "$seen" != *"|${rname}|"* ]]; then
        seen="${seen}|${rname}|"
        echo "$rname"
      fi
    fi
  done <<< "$parsed"
}

# Get a specific field from a rule
get_rule_field() {
  local rulename="$1" field="$2"
  local prefix="RULE:${rulename}:${field}="
  local parsed
  parsed="$(parse_config)"
  local line
  while IFS= read -r line; do
    if [[ "$line" == "${prefix}"* ]]; then
      echo "${line#${prefix}}"
      return 0
    fi
  done <<< "$parsed"
}

# ── Config writer helpers ──────────────────────────────────────────────────────

# validate_profile_name: accepts [a-zA-Z0-9_-], rejects names starting with "rule"
validate_profile_name() {
  local name="$1"
  if [[ ! "$name" =~ ^[a-zA-Z0-9_-]+$ ]]; then
    echo "git-profile: invalid profile name '${name}'. Use only letters, digits, hyphens, underscores." >&2
    return 1
  fi
  if [[ "$name" == rule* ]]; then
    echo "git-profile: profile name may not start with 'rule'." >&2
    return 1
  fi
}

# delete_config_section: removes a section block from CONF_FILE
# For a plain profile section, pass the section name (e.g. "personal")
# For a rule section, pass "rule:rulename" (e.g. "rule:my-rule")
delete_config_section() {
  local section_arg="$1"
  local conf="${CONF_FILE}"
  [[ -f "$conf" ]] || return 0

  local header_pattern
  if [[ "$section_arg" == rule:* ]]; then
    local rulename="${section_arg#rule:}"
    header_pattern="[rule \"${rulename}\"]"
  else
    header_pattern="[${section_arg}]"
  fi

  local tmp
  tmp="$(mktemp)"

  awk -v hdr="$header_pattern" '
    BEGIN { skip = 0 }
    {
      # Detect any section header
      if ($0 ~ /^\[/) {
        if ($0 == hdr) {
          skip = 1
        } else {
          skip = 0
        }
      }
      if (!skip) print
    }
  ' "$conf" > "$tmp"

  mv "$tmp" "$conf"
}

# write_profile_section: writes (or overwrites) a [profile] section
# Usage: write_profile_section name "Full Name" "email" "host" "ssh_key"
write_profile_section() {
  local name="$1" fullname="$2" email="$3" host="$4" ssh_key="$5"

  # Delete existing section first
  delete_config_section "$name"

  # Append new section
  {
    echo ""
    echo "[${name}]"
    echo "name = ${fullname}"
    echo "email = ${email}"
    echo "host = ${host}"
    echo "ssh_key = ${ssh_key}"
  } >> "$CONF_FILE"
}

# write_rule_section: writes (or overwrites) a [rule "name"] section
# Usage: write_rule_section rulename dir profile
write_rule_section() {
  local rulename="$1" dir="$2" profile="$3"

  # Delete existing rule section first
  delete_config_section "rule:${rulename}"

  # Append new section
  {
    echo ""
    echo "[rule \"${rulename}\"]"
    echo "dir = ${dir}"
    echo "profile = ${profile}"
  } >> "$CONF_FILE"
}

# ── Subcommand implementations ────────────────────────────────────────────────

cmd_list() {
  local names
  names="$(list_profile_names)"
  if [[ -z "$names" ]]; then
    echo "No profiles configured."
    echo "Run 'git-profile add' to create one."
    return 0
  fi

  echo "Configured profiles:"
  echo ""
  local profile
  while IFS= read -r profile; do
    [[ -z "$profile" ]] && continue
    local name email host ssh_key
    name="$(get_profile_field "$profile" "name")"
    email="$(get_profile_field "$profile" "email")"
    host="$(get_profile_field "$profile" "host")"
    ssh_key="$(get_profile_field "$profile" "ssh_key")"
    echo "  [${profile}]"
    echo "    name    = ${name}"
    echo "    email   = ${email}"
    echo "    host    = ${host}"
    echo "    ssh_key = ${ssh_key}"
    echo ""
  done <<< "$names"
}

cmd_add() {
  echo "git-profile add: interactive add not yet implemented." >&2
}

cmd_edit() {
  echo "git-profile edit: not yet implemented." >&2
}

cmd_remove() {
  echo "git-profile remove: not yet implemented." >&2
}

cmd_use() {
  echo "git-profile use: not yet implemented." >&2
}

cmd_show() {
  echo "git-profile show: not yet implemented." >&2
}

cmd_install() {
  echo "git-profile install: not yet implemented." >&2
}

cmd_check() {
  echo "git-profile check: not yet implemented." >&2
}

# ── Rule subcommands ──────────────────────────────────────────────────────────

cmd_rule_list() {
  local names
  names="$(list_rule_names)"
  if [[ -z "$names" ]]; then
    echo "No rules configured."
    return 0
  fi

  echo "Configured rules:"
  echo ""
  local rule
  while IFS= read -r rule; do
    [[ -z "$rule" ]] && continue
    local dir profile
    dir="$(get_rule_field "$rule" "dir")"
    profile="$(get_rule_field "$rule" "profile")"
    echo "  [rule \"${rule}\"]"
    echo "    dir     = ${dir}"
    echo "    profile = ${profile}"
    echo ""
  done <<< "$names"
}

cmd_rule_add() {
  echo "git-profile rule add: not yet implemented." >&2
}

cmd_rule_remove() {
  echo "git-profile rule remove: not yet implemented." >&2
}

cmd_rule() {
  local sub="${1:-}"
  case "$sub" in
    add)    shift; cmd_rule_add "$@" ;;
    list)   cmd_rule_list ;;
    remove) shift; cmd_rule_remove "$@" ;;
    "")     interactive_rule_menu ;;
    *)
      echo "git-profile rule: unknown subcommand '${sub}'" >&2
      echo "Usage: git-profile rule [add|list|remove]" >&2
      exit 1
      ;;
  esac
}

interactive_rule_menu() {
  echo "git-profile rule: interactive menu not yet implemented." >&2
}

# ── Hidden internal commands (used by tests and other subcommands) ─────────────

cmd_internal_write_profile() {
  # Usage: _write_profile <name> <fullname> <email> <host> <ssh_key>
  if [[ $# -lt 5 ]]; then
    echo "Usage: git-profile _write_profile <name> <fullname> <email> <host> <ssh_key>" >&2
    exit 1
  fi
  local name="$1" fullname="$2" email="$3" host="$4" ssh_key="$5"
  validate_profile_name "$name"
  write_profile_section "$name" "$fullname" "$email" "$host" "$ssh_key"
}

cmd_internal_delete_section() {
  # Usage: _delete_section <section-name-or-rule:name>
  if [[ $# -lt 1 ]]; then
    echo "Usage: git-profile _delete_section <name>" >&2
    exit 1
  fi
  delete_config_section "$1"
}

cmd_internal_write_rule() {
  # Usage: _write_rule <rulename> <dir> <profile>
  if [[ $# -lt 3 ]]; then
    echo "Usage: git-profile _write_rule <rulename> <dir> <profile>" >&2
    exit 1
  fi
  write_rule_section "$1" "$2" "$3"
}

# ── Main dispatcher ───────────────────────────────────────────────────────────
main() {
  check_dependencies

  local cmd="${1:-}"

  case "$cmd" in
    --version|-V)
      echo "git-profile version ${VERSION}"
      ;;
    --help|-h|help)
      show_help
      ;;
    list)
      shift
      cmd_list "$@"
      ;;
    add)
      shift
      cmd_add "$@"
      ;;
    edit)
      shift
      cmd_edit "$@"
      ;;
    remove|rm)
      shift
      cmd_remove "$@"
      ;;
    use)
      shift
      cmd_use "$@"
      ;;
    show)
      shift
      cmd_show "$@"
      ;;
    install)
      shift
      cmd_install "$@"
      ;;
    check)
      shift
      cmd_check "$@"
      ;;
    rule)
      shift
      cmd_rule "$@"
      ;;
    # Hidden internal commands for testing and internal use
    _write_profile)
      shift
      cmd_internal_write_profile "$@"
      ;;
    _delete_section)
      shift
      cmd_internal_delete_section "$@"
      ;;
    _write_rule)
      shift
      cmd_internal_write_rule "$@"
      ;;
    "")
      show_help
      exit 0
      ;;
    *)
      echo "git-profile: unknown subcommand '${cmd}'" >&2
      echo "Run 'git-profile --help' for usage." >&2
      exit 1
      ;;
  esac
}

main "$@"
