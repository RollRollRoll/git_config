# ── Rule helpers ──────────────────────────────────────────────────────────────

# normalize_path: expand ~, make absolute, use cd+pwd if dir exists (fallback: realpath), ensure trailing /
normalize_path() {
  local path="$1"

  # Expand leading ~
  path="${path/#\~/$HOME}"

  # If directory exists, resolve canonically using cd+pwd (avoids symlink resolution
  # issues where realpath may return a different symlink-resolved path than mktemp -d)
  if [[ -d "$path" ]]; then
    path="$(cd "$path" && pwd)" || {
      if command -v realpath &>/dev/null; then
        path="$(realpath "$path" 2>/dev/null)" || true
      fi
    }
  else
    # Directory does not exist — warn and keep as-is (make absolute if relative)
    echo "git-profile: warning: directory '${path}' does not exist." >&2
    if [[ "$path" != /* ]]; then
      path="$(pwd)/${path}"
    fi
  fi

  # Ensure trailing /
  path="${path%/}/"
  echo "$path"
}

# write_gitconfig_fragment: write a gitconfig.d/<profile> fragment
# Usage: write_gitconfig_fragment <profile_name> <fullname> <email> <key_path>
write_gitconfig_fragment() {
  local profile="$1" fullname="$2" email="$3" key_path="$4"
  local fragment_file="${GITCONFIG_D}/${profile}"

  mkdir -p "$GITCONFIG_D"

  cat > "$fragment_file" <<EOF
[gitProfile]
  name = ${profile}
[user]
  name = ${fullname}
  email = ${email}
[core]
  sshCommand = ssh -i "${key_path}" -o IdentitiesOnly=yes
EOF
}

# _rule_add: core rule add logic
# Usage: _rule_add <rule_name> <dir> <profile>
_rule_add() {
  local rule_name="$1" dir="$2" profile="$3"

  # Validate profile exists
  local p_name
  p_name="$(get_profile_field "$profile" "name")"
  if [[ -z "$p_name" ]]; then
    echo "git-profile: profile '${profile}' not found." >&2
    exit 1
  fi

  # Normalize the path
  local norm_dir
  norm_dir="$(normalize_path "$dir")"

  # Write rule section to config
  write_rule_section "$rule_name" "$norm_dir" "$profile"

  # Generate gitconfig.d fragment
  local p_email p_key
  p_email="$(get_profile_field "$profile" "email")"
  p_key="$(get_profile_field "$profile" "ssh_key")"
  # Expand ~ in key path
  p_key="${p_key/#\~/$HOME}"

  write_gitconfig_fragment "$profile" "$p_name" "$p_email" "$p_key"

  # Write includeIf to global gitconfig
  local fragment_file="${GITCONFIG_D}/${profile}"
  git config --global "includeIf.gitdir:${norm_dir}.path" "$fragment_file"

  echo "Rule '${rule_name}' added: ${norm_dir} -> profile '${profile}'"
}

# ── Rule subcommands ──────────────────────────────────────────────────────────

cmd_rule_list() {
  local names
  names="$(list_rule_names)"
  if [[ -z "$names" ]]; then
    echo "No rules configured."
    return 0
  fi

  echo "Configured rules:"
  echo ""
  local rule
  while IFS= read -r rule; do
    [[ -z "$rule" ]] && continue
    local dir profile
    dir="$(get_rule_field "$rule" "dir")"
    profile="$(get_rule_field "$rule" "profile")"
    echo "  [rule \"${rule}\"]"
    echo "    dir     = ${dir}"
    echo "    profile = ${profile}"
    echo ""
  done <<< "$names"
}

cmd_rule_add() {
  # ── 1. Rule name ──────────────────────────────────────────────────────────
  local rule_name=""
  while [[ -z "$rule_name" ]]; do
    printf "Rule name (letters, digits, hyphens, underscores): "
    read -r rule_name
    if [[ -z "$rule_name" ]]; then
      echo "Rule name cannot be empty." >&2
    fi
  done

  # ── 2. Directory ──────────────────────────────────────────────────────────
  local dir=""
  while [[ -z "$dir" ]]; do
    printf "Directory to match (e.g. ~/projects/work/): "
    read -r dir
    if [[ -z "$dir" ]]; then
      echo "Directory cannot be empty." >&2
    fi
  done

  # ── 3. Profile ────────────────────────────────────────────────────────────
  local profile=""
  while [[ -z "$profile" ]]; do
    printf "Profile to apply: "
    read -r profile
    if [[ -z "$profile" ]]; then
      echo "Profile cannot be empty." >&2
    fi
  done

  _rule_add "$rule_name" "$dir" "$profile"
}

cmd_rule_remove() {
  echo "git-profile rule remove: not yet implemented." >&2
}

cmd_rule() {
  local sub="${1:-}"
  case "$sub" in
    add)    shift; cmd_rule_add "$@" ;;
    list)   cmd_rule_list ;;
    remove) shift; cmd_rule_remove "$@" ;;
    "")     interactive_rule_menu ;;
    *)
      echo "git-profile rule: unknown subcommand '${sub}'" >&2
      echo "Usage: git-profile rule [add|list|remove]" >&2
      exit 1
      ;;
  esac
}

interactive_rule_menu() {
  echo "git-profile rule: interactive menu not yet implemented." >&2
}

# ── Hidden internal commands (used by tests and other subcommands) ─────────────

cmd_internal_write_profile() {
  # Usage: _write_profile <name> <fullname> <email> <host> <ssh_key>
  if [[ $# -lt 5 ]]; then
    echo "Usage: git-profile _write_profile <name> <fullname> <email> <host> <ssh_key>" >&2
    exit 1
  fi
  local name="$1" fullname="$2" email="$3" host="$4" ssh_key="$5"
  validate_profile_name "$name"
  write_profile_section "$name" "$fullname" "$email" "$host" "$ssh_key"
}

cmd_internal_delete_section() {
  # Usage: _delete_section <section-name-or-rule:name>
  if [[ $# -lt 1 ]]; then
    echo "Usage: git-profile _delete_section <name>" >&2
    exit 1
  fi
  delete_config_section "$1"
}

cmd_internal_write_rule() {
  # Usage: _write_rule <rulename> <dir> <profile>
  if [[ $# -lt 3 ]]; then
    echo "Usage: git-profile _write_rule <rulename> <dir> <profile>" >&2
    exit 1
  fi
  write_rule_section "$1" "$2" "$3"
}

cmd_internal_add_profile() {
  # Usage: _add_profile <name> <user> <email> <host> <key_path>
  if [[ $# -lt 5 ]]; then
    echo "Usage: git-profile _add_profile <name> <user> <email> <host> <key_path>" >&2
    exit 1
  fi
  _add_profile "$1" "$2" "$3" "$4" "$5"
}

cmd_internal_add_profile_with_keygen() {
  # Usage: _add_profile_with_keygen <name> <user> <email> <host> <algorithm>
  if [[ $# -lt 5 ]]; then
    echo "Usage: git-profile _add_profile_with_keygen <name> <user> <email> <host> <algorithm>" >&2
    exit 1
  fi
  _add_profile_with_keygen "$1" "$2" "$3" "$4" "$5"
}

# ── Main dispatcher ───────────────────────────────────────────────────────────
main() {
  check_dependencies

  local cmd="${1:-}"

  case "$cmd" in
    --version|-V)
      echo "git-profile version ${VERSION}"
      ;;
    --help|-h|help)
      show_help
      ;;
    list)
      shift
      cmd_list "$@"
      ;;
    add)
      shift
      cmd_add "$@"
      ;;
    edit)
      shift
      cmd_edit "$@"
      ;;
    remove|rm)
      shift
      cmd_remove "$@"
      ;;
    use)
      shift
      cmd_use "$@"
      ;;
    show)
      shift
      cmd_show "$@"
      ;;
    install)
      shift
      cmd_install "$@"
      ;;
    check)
      shift
      cmd_check "$@"
      ;;
    current)
      shift
      cmd_current "$@"
      ;;
    rule)
      shift
      cmd_rule "$@"
      ;;
    # Hidden internal commands for testing and internal use
    _write_profile)
      shift
      cmd_internal_write_profile "$@"
      ;;
    _delete_section)
      shift
      cmd_internal_delete_section "$@"
      ;;
    _write_rule)
      shift
      cmd_internal_write_rule "$@"
      ;;
    _add_profile)
      shift
      cmd_internal_add_profile "$@"
      ;;
    _add_profile_with_keygen)
      shift
      cmd_internal_add_profile_with_keygen "$@"
      ;;
    _rule_add)
      shift
      if [[ $# -lt 3 ]]; then
        echo "Usage: git-profile _rule_add <rule_name> <dir> <profile>" >&2
        exit 1
      fi
      _rule_add "$1" "$2" "$3"
      ;;
    "")
      show_help
      exit 0
      ;;
    *)
      echo "git-profile: unknown subcommand '${cmd}'" >&2
      echo "Run 'git-profile --help' for usage." >&2
      exit 1
      ;;
  esac
}

main "$@"
