#!/usr/bin/env bash
# git-profile — manage per-context Git identities
set -euo pipefail

VERSION="0.1.0"

# ── Environment-overridable config paths ─────────────────────────────────────
CONF_FILE="${CONF_FILE:-${HOME}/.git-profiles.conf}"
GITCONFIG_D="${GITCONFIG_D:-${HOME}/.gitconfig.d}"

# ── Utility: resolve a path with realpath fallback ───────────────────────────
resolve_path() {
  local path="$1"
  if command -v realpath &>/dev/null; then
    realpath "$path" 2>/dev/null || echo "$path"
  else
    # Bash 3.2 compatible fallback
    local dir base
    dir="$(cd "$(dirname "$path")" 2>/dev/null && pwd)" || { echo "$path"; return; }
    base="$(basename "$path")"
    echo "${dir}/${base}"
  fi
}

# ── Dependency check (Bash 3.2 compatible, no associative arrays) ─────────────
check_dependencies() {
  local missing=""
  local deps="git ssh-keygen awk sed"
  local dep
  for dep in $deps; do
    if ! command -v "$dep" &>/dev/null; then
      missing="${missing} ${dep}"
    fi
  done
  if [[ -n "$missing" ]]; then
    echo "git-profile: missing required dependencies:${missing}" >&2
    echo "Please install the missing tools and try again." >&2
    exit 1
  fi
}

# ── Help text ─────────────────────────────────────────────────────────────────
show_help() {
  cat <<EOF
Usage: git-profile <subcommand> [options]

Manage per-context Git identities via profiles.

Subcommands:
  list                     List all configured profiles
  add                      Add or update a profile (interactive)
  edit <profile>           Edit an existing profile
  remove <profile>         Remove a profile
  use <profile>            Apply a profile to the current repository
  show [profile]           Show profile details
  rule [add|list|remove]   Manage auto-apply rules
  install                  Install shell integration and SSH config
  check                    Check current repository's active profile

Options:
  --help       Show this help message
  --version    Show version information

Config file: ${CONF_FILE}
Fragments:   ${GITCONFIG_D}/

Examples:
  git-profile add
  git-profile list
  git-profile use personal
  git-profile rule add
  git-profile rule list
EOF
}

