#!/usr/bin/env bash
# git-relay — Git 多远程中转同步工具
# 适用场景：外网服务器不能直接访问公司 Git 服务器时的代码中转同步
#
# 链路：公司仓库(corp) <-> 本地工作仓库 <-> 外网裸仓库(relay) <-> 外网工作区
set -euo pipefail

VERSION="0.1.0"

# ── 配置文件路径（优先级：环境变量 > 项目级 > 全局） ─────────────────────────
GLOBAL_CONF_FILE="${HOME}/.git-relay.conf"

_resolve_conf_file() {
  # 1. 环境变量显式指定
  if [[ -n "${CONF_FILE:-}" ]]; then
    echo "$CONF_FILE"
    return
  fi
  # 2. 当前 git 仓库根目录下的 .git-relay.conf
  local repo_root
  repo_root="$(git rev-parse --show-toplevel 2>/dev/null || echo '')"
  if [[ -n "$repo_root" && -f "${repo_root}/.git-relay.conf" ]]; then
    echo "${repo_root}/.git-relay.conf"
    return
  fi
  # 3. 回退到全局配置
  echo "$GLOBAL_CONF_FILE"
}

# 记录是否由环境变量显式指定（供 config-show 标注来源）
CONF_FILE_ORIG_ENV="${CONF_FILE:-}"
CONF_FILE="$(_resolve_conf_file)"

# ── 颜色输出 ──────────────────────────────────────────────────────────────────
_c_reset='\033[0m'
_c_bold='\033[1m'
_c_red='\033[0;31m'
_c_green='\033[0;32m'
_c_yellow='\033[0;33m'
_c_cyan='\033[0;36m'

info()    { echo -e "${_c_cyan}▶${_c_reset} $*"; }
success() { echo -e "${_c_green}✔${_c_reset} $*"; }
warn()    { echo -e "${_c_yellow}⚠${_c_reset} $*"; }
error()   { echo -e "${_c_red}✖${_c_reset} $*" >&2; }
step()    { echo -e "${_c_bold}── $* ──${_c_reset}"; }
die()     { error "$*"; exit 1; }

# ── 帮助文本 ──────────────────────────────────────────────────────────────────
show_help() {
  cat <<EOF
Usage: git-relay <子命令> [选项]

Git 多远程中转同步工具
链路：公司仓库(corp) ↔ 本地 ↔ 外网裸仓库(relay) ↔ 外网工作区

子命令：
  config               配置中转连接参数（交互式，首次运行必须先执行）
  config-show          显示当前配置
  init                 一次性初始化（在外网服务器建裸仓库 + 本地添加 relay remote）
  init-server          仅在外网服务器上创建裸仓库和工作区
  init-local           仅在本地配置 relay remote 并首次推送

  push-to-relay        本地 → 将公司最新代码推送到外网裸仓库（日常同步入口）
  relay-pull [分支名]  外网服务器 → 从裸仓库拉取指定分支（默认主分支，ssh 远程执行）

  feature-start <名称>  外网服务器上创建功能分支（ssh 远程执行）
  relay-push          外网服务器将功能分支推回裸仓库（ssh 远程执行）
  pull-from-relay <名称>   本地从 relay 拉取功能分支（首次或更新）
  relay-merge <名称>  本地合并功能分支并推回公司仓库
  feature-clean <名称>  清理本地 + relay + 外网服务器的功能分支

  sync-to-relay   = push-to-relay + relay-pull（一步完成同步到服务器，relay-pull 使用主分支）
  sync-from-relay  = relay-push(server) + pull-from-relay + relay-merge（服务器提交同步回公司）

  status               显示本地远程状态和分支跟踪关系

选项：
  --help      显示帮助
  --version   显示版本

配置文件优先级：
  1. 环境变量 CONF_FILE（显式指定）
  2. 项目根目录 .git-relay.conf（项目级，推荐加入 .gitignore）
  3. ~/.git-relay.conf（全局默认）

当前生效配置：${CONF_FILE}

工作流示例：
  # 1. 首次初始化
  git-relay config
  git-relay init

  # 2. 每次开始远程开发前（同步公司最新到服务器）
  git-relay sync-to-relay

  # 3. 服务器上创建功能分支开发
  git-relay feature-start my-feature

  # 4. 开发完毕后，服务器推回裸仓库
  git-relay relay-push

  # 5. 本地拉回并合并推回公司
  git-relay pull-from-relay my-feature
  git-relay relay-merge my-feature

  # 6. 清理
  git-relay feature-clean my-feature
EOF
}

# ── 配置文件读写 ──────────────────────────────────────────────────────────────

# 读取配置项：conf_get <key>
conf_get() {
  local key="$1"
  [[ -f "$CONF_FILE" ]] || return 1
  local line
  while IFS= read -r line || [[ -n "$line" ]]; do
    line="${line#"${line%%[![:space:]]*}"}"
    [[ -z "$line" || "$line" == \#* ]] && continue
    if [[ "$line" == "${key}="* ]]; then
      local val="${line#*=}"
      # 去除行尾空白和 \r（兼容 Windows 换行符）
      val="${val%"${val##*[! $'\r\t']}"}"
      echo "$val"
      return 0
    fi
  done < "$CONF_FILE"
  return 1
}

# 写入/更新配置项：conf_set <key> <value>
conf_set() {
  local key="$1" value="$2"
  if [[ -f "$CONF_FILE" ]] && grep -q "^${key}=" "$CONF_FILE" 2>/dev/null; then
    # 更新已有项
    local tmp
    tmp="$(mktemp)"
    while IFS= read -r line || [[ -n "$line" ]]; do
      if [[ "$line" == "${key}="* ]]; then
        echo "${key}=${value}"
      else
        echo "$line"
      fi
    done < "$CONF_FILE" > "$tmp"
    mv "$tmp" "$CONF_FILE"
  else
    echo "${key}=${value}" >> "$CONF_FILE"
  fi
  chmod 600 "$CONF_FILE"
}

# 加载配置并导出到变量，找不到则 die
load_conf() {
  [[ -f "$CONF_FILE" ]] || die "未找到配置文件 ${CONF_FILE}，请先运行: git-relay config"

  # server_user / ssh_port 为可选项，不填时依赖 ~/.ssh/config 中的 Host 别名
  RELAY_SERVER_USER="$(conf_get server_user 2>/dev/null || echo '')"
  RELAY_SERVER_HOST="$(conf_get server_host 2>/dev/null)" || die "配置缺少 server_host，请重新运行: git-relay config"
  RELAY_PROJECT="$(conf_get project_name 2>/dev/null)"    || die "配置缺少 project_name，请重新运行: git-relay config"
  RELAY_BRANCH="$(conf_get default_branch 2>/dev/null)"   || die "配置缺少 default_branch，请重新运行: git-relay config"
  RELAY_SSH_PORT="$(conf_get ssh_port 2>/dev/null || echo '')"

  # 可自定义的 remote 名称，默认 corp / relay
  RELAY_CORP_REMOTE="$(conf_get corp_remote 2>/dev/null || echo 'corp')"
  RELAY_RELAY_REMOTE="$(conf_get relay_remote 2>/dev/null || echo 'relay')"

  # corp URL：优先从配置读取，其次从已有 remote 获取
  RELAY_CORP_URL="$(conf_get corp_url 2>/dev/null || git remote get-url "$RELAY_CORP_REMOTE" 2>/dev/null || echo '')"
  [[ -n "$RELAY_CORP_URL" ]] || die "无法确定公司仓库 URL，请重新运行: git-relay config"

  # SSH 连接目标：有 server_user 则用 user@host，否则直接用 host（依赖 SSH config）
  if [[ -n "$RELAY_SERVER_USER" ]]; then
    RELAY_SSH_TARGET="${RELAY_SERVER_USER}@${RELAY_SERVER_HOST}"
  else
    RELAY_SSH_TARGET="${RELAY_SERVER_HOST}"
  fi

  # 服务器路径：优先读取自定义配置，否则派生默认路径
  # server_user 为空时，若无自定义路径则通过 SSH 解析远端用户名（只查询一次）
  local _custom_bare _custom_work
  _custom_bare="$(conf_get server_bare_path 2>/dev/null || echo '')"
  _custom_work="$(conf_get server_work_path 2>/dev/null || echo '')"

  if [[ -n "$_custom_bare" && -n "$_custom_work" ]]; then
    RELAY_BARE_PATH="$_custom_bare"
    RELAY_WORK_PATH="$_custom_work"
  else
    # 需要用户名来派生默认路径
    local _path_user="$RELAY_SERVER_USER"
    if [[ -z "$_path_user" ]]; then
      info "server_user 未配置，正在通过 SSH 解析服务器用户名..."
      _path_user="$(ssh "$RELAY_SSH_TARGET" 'whoami' 2>/dev/null)" || \
        die "无法获取服务器用户名，请配置 server_user 或显式指定 server_bare_path / server_work_path"
    fi
    RELAY_BARE_PATH="${_custom_bare:-/home/${_path_user}/relay/repos/${RELAY_PROJECT}.git}"
    RELAY_WORK_PATH="${_custom_work:-/home/${_path_user}/relay/worktrees/${RELAY_PROJECT}}"
  fi

  # relay remote URL：有非标端口则用 ssh:// 格式，否则用 scp 格式
  if [[ -n "$RELAY_SSH_PORT" && "$RELAY_SSH_PORT" != "22" ]]; then
    RELAY_REMOTE_URL="ssh://${RELAY_SSH_TARGET}:${RELAY_SSH_PORT}${RELAY_BARE_PATH}"
  else
    RELAY_REMOTE_URL="${RELAY_SSH_TARGET}:${RELAY_BARE_PATH}"
  fi
}

# ── 输入工具 ──────────────────────────────────────────────────────────────────

# prompt_input <提示> <默认值变量名>
prompt_input() {
  local prompt="$1" var_name="$2" default="${3:-}"
  local input
  if [[ -n "$default" ]]; then
    read -r -p "$(echo -e "${_c_cyan}${prompt}${_c_reset} [${default}]: ")" input
    input="${input:-$default}"
  else
    read -r -p "$(echo -e "${_c_cyan}${prompt}${_c_reset}: ")" input
    while [[ -z "$input" ]]; do
      warn "不能为空，请重新输入"
      read -r -p "$(echo -e "${_c_cyan}${prompt}${_c_reset}: ")" input
    done
  fi
  printf -v "$var_name" '%s' "$input"
}

# prompt_input_optional — 允许留空，留空时变量设为空字符串
prompt_input_optional() {
  local prompt="$1" var_name="$2" default="${3:-}"
  local input
  if [[ -n "$default" ]]; then
    read -r -p "$(echo -e "${_c_cyan}${prompt}${_c_reset} [${default}]: ")" input
    input="${input:-$default}"
  else
    read -r -p "$(echo -e "${_c_cyan}${prompt}${_c_reset} (可留空): ")" input
  fi
  printf -v "$var_name" '%s' "$input"
}

# 确认提示：confirm <提示>，返回 0=确认 1=取消
confirm() {
  local prompt="$1"
  local ans
  read -r -p "$(echo -e "${_c_yellow}${prompt} [y/N]${_c_reset}: ")" ans
  [[ "$ans" =~ ^[Yy]$ ]]
}

# ── SSH 远程执行 ──────────────────────────────────────────────────────────────

# ssh_run <命令>  — 在外网服务器上执行命令
# 通过 stdin 传递命令脚本，避免 SSH 参数拼接对引号和换行的二次解析问题
ssh_run() {
  local cmd="$1"
  local ssh_opts="-o StrictHostKeyChecking=accept-new"
  # 仅在显式配置了非标端口时才加 -p（标准端口 22 或依赖 SSH config 时均不加）
  if [[ -n "$RELAY_SSH_PORT" && "$RELAY_SSH_PORT" != "22" ]]; then
    ssh_opts="${ssh_opts} -p ${RELAY_SSH_PORT}"
  fi
  # shellcheck disable=SC2086
  echo "$cmd" | ssh $ssh_opts "$RELAY_SSH_TARGET" bash
}

# ── 子命令实现 ────────────────────────────────────────────────────────────────

# config — 交互式配置
cmd_config() {
  step "配置 git-relay 连接参数"

  # ── 选择保存位置 ──────────────────────────────────────────────────────────
  local save_target="$CONF_FILE"
  local repo_root
  repo_root="$(git rev-parse --show-toplevel 2>/dev/null || echo '')"

  if [[ -n "$repo_root" ]]; then
    local project_conf="${repo_root}/.git-relay.conf"
    echo "保存位置："
    echo "  1) 项目级  ${project_conf}"
    echo "  2) 全局    ${GLOBAL_CONF_FILE}"
    echo
    local scope_choice
    read -r -p "$(echo -e "${_c_cyan}请选择 [1/2]${_c_reset} (默认 1): ")" scope_choice
    scope_choice="${scope_choice:-1}"
    if [[ "$scope_choice" == "2" ]]; then
      save_target="$GLOBAL_CONF_FILE"
    else
      save_target="$project_conf"
      # 提示加入 .gitignore
      if [[ -f "${repo_root}/.gitignore" ]] && ! grep -qF '.git-relay.conf' "${repo_root}/.gitignore" 2>/dev/null; then
        warn "建议将 .git-relay.conf 加入 .gitignore 以避免泄露服务器信息"
        if confirm "自动添加到 .gitignore？"; then
          echo '.git-relay.conf' >> "${repo_root}/.gitignore"
          success "已添加到 .gitignore"
        fi
      fi
    fi
  fi

  # 切换到目标配置文件读取当前值
  local orig_conf="$CONF_FILE"
  CONF_FILE="$save_target"

  echo
  echo "请输入以下信息（已有值直接回车保留）："
  echo

  local cur_user cur_host cur_port cur_project cur_branch
  local cur_corp_remote cur_relay_remote cur_corp_url

  cur_user="$(conf_get server_user 2>/dev/null || echo '')"
  cur_host="$(conf_get server_host 2>/dev/null || echo '')"
  cur_port="$(conf_get ssh_port 2>/dev/null || echo '22')"
  cur_project="$(conf_get project_name 2>/dev/null || echo "${repo_root:+$(basename "$repo_root")}")"
  cur_branch="$(conf_get default_branch 2>/dev/null || echo 'main')"
  cur_corp_remote="$(conf_get corp_remote 2>/dev/null || echo 'corp')"
  cur_relay_remote="$(conf_get relay_remote 2>/dev/null || echo 'relay')"
  cur_corp_url="$(conf_get corp_url 2>/dev/null || echo '')"

  local v_user v_host v_port v_project v_branch v_corp_remote v_relay_remote v_corp_url
  local v_bare_path v_work_path

  prompt_input          "外网服务器地址/别名 (server_host)"              v_host "$cur_host"
  prompt_input_optional "外网服务器用户名 (server_user，SSH config 中有则留空)" v_user "$cur_user"
  prompt_input_optional "SSH 端口 (ssh_port，SSH config 中有则留空)"          v_port "$cur_port"
  prompt_input "项目名 (project_name)"             v_project      "$cur_project"
  prompt_input "默认分支 (default_branch)"         v_branch       "$cur_branch"
  prompt_input "公司仓库 remote 名 (corp_remote)"  v_corp_remote  "$cur_corp_remote"
  prompt_input "中转仓库 remote 名 (relay_remote)" v_relay_remote "$cur_relay_remote"

  # 服务器路径：计算默认值供展示，允许用户覆盖
  local _def_bare="/home/${v_user}/relay/repos/${v_project}.git"
  local _def_work="/home/${v_user}/relay/worktrees/${v_project}"
  local cur_bare cur_work
  cur_bare="$(conf_get server_bare_path 2>/dev/null || echo "$_def_bare")"
  cur_work="$(conf_get server_work_path 2>/dev/null || echo "$_def_work")"
  echo
  info "服务器路径（直接回车使用默认值）："
  prompt_input "裸仓库路径 (server_bare_path)" v_bare_path "$cur_bare"
  prompt_input "工作区路径 (server_work_path)" v_work_path "$cur_work"

  # ── 公司仓库 URL：选择已有 remote 或手动输入 ────────────────────────────
  local v_corp_url=""
  local existing_remotes=()
  if git rev-parse --git-dir &>/dev/null 2>&1; then
    while IFS= read -r r; do
      existing_remotes+=("$r")
    done < <(git remote 2>/dev/null)
  fi

  if [[ ${#existing_remotes[@]} -gt 0 ]]; then
    echo
    echo "公司仓库 URL 来源："
    echo "  0) 手动输入 URL"
    local i=1
    for r in "${existing_remotes[@]}"; do
      local rurl
      rurl="$(git remote get-url "$r" 2>/dev/null || echo '(无法获取)')"
      echo "  ${i}) 使用已有 remote「${r}」→ ${rurl}"
      (( i++ ))
    done
    echo
    local url_choice
    read -r -p "$(echo -e "${_c_cyan}请选择 [0-$((i-1))]${_c_reset} (默认 0): ")" url_choice
    url_choice="${url_choice:-0}"

    if [[ "$url_choice" =~ ^[1-9][0-9]*$ ]] && (( url_choice <= ${#existing_remotes[@]} )); then
      local chosen_remote="${existing_remotes[$((url_choice-1))]}"
      v_corp_url="$(git remote get-url "$chosen_remote" 2>/dev/null || echo '')"
      # 若选择的 remote 名与 corp_remote 一致，无需另存 corp_url
      if [[ "$chosen_remote" == "$v_corp_remote" ]]; then
        v_corp_url=""   # 运行时直接从 remote 读，不写死到配置
        info "将直接使用 remote「${chosen_remote}」，不单独存储 corp_url"
      else
        info "已读取 remote「${chosen_remote}」的 URL: ${v_corp_url}"
      fi
    fi
  fi

  if [[ -z "$v_corp_url" && "$url_choice" == "0" ]]; then
    prompt_input "公司仓库 URL (corp_url)" v_corp_url "$cur_corp_url"
  fi

  conf_set server_host    "$v_host"
  conf_set project_name   "$v_project"
  conf_set default_branch "$v_branch"
  conf_set corp_remote    "$v_corp_remote"
  conf_set relay_remote   "$v_relay_remote"
  # server_user / ssh_port 为可选项：有值则写入，已有旧值但用户清空则也写入（覆盖为空）
  if [[ -n "$v_user" ]] || grep -q "^server_user=" "$CONF_FILE" 2>/dev/null; then
    conf_set server_user "$v_user"
  fi
  if [[ -n "$v_port" ]] || grep -q "^ssh_port=" "$CONF_FILE" 2>/dev/null; then
    conf_set ssh_port "$v_port"
  fi
  if [[ -n "$v_corp_url" ]]; then
    conf_set corp_url "$v_corp_url"
  fi
  # 路径只在与默认值不同时写入（保持配置文件简洁）
  # server_user 可能为空，路径默认值用运行时解析的值，这里仅做保存判断
  local _save_def_bare="/home/${v_user}/relay/repos/${v_project}.git"
  local _save_def_work="/home/${v_user}/relay/worktrees/${v_project}"
  if [[ "$v_bare_path" != "$_save_def_bare" ]]; then
    conf_set server_bare_path "$v_bare_path"
  fi
  if [[ "$v_work_path" != "$_save_def_work" ]]; then
    conf_set server_work_path "$v_work_path"
  fi

  # 使后续命令在本次进程内也用新配置
  CONF_FILE="$save_target"

  success "配置已保存至 ${CONF_FILE}"
  echo
  cmd_config_show
}

# config-show — 显示当前配置
cmd_config_show() {
  [[ -f "$CONF_FILE" ]] || die "未找到配置文件，请先运行: git-relay config"

  # 标注配置来源
  local source_label
  if [[ -n "${CONF_FILE_ORIG_ENV:-}" ]]; then
    source_label="环境变量指定"
  elif [[ "$CONF_FILE" == "$GLOBAL_CONF_FILE" ]]; then
    source_label="全局"
  else
    source_label="项目级"
  fi

  step "当前配置 [${source_label}] ${CONF_FILE}"
  cat "$CONF_FILE"
}

# init-server — 在外网服务器上创建裸仓库和工作区
cmd_init_server() {
  load_conf
  step "在外网服务器上初始化裸仓库"
  info "服务器: ${RELAY_SERVER_USER}@${RELAY_SERVER_HOST}"
  info "裸仓库: ${RELAY_BARE_PATH}"
  info "工作区: ${RELAY_WORK_PATH}"
  echo

  # 检查是否已经存在
  local exists
  exists="$(ssh_run "[ -d '${RELAY_BARE_PATH}' ] && echo yes || echo no")"
  if [[ "$exists" == "yes" ]]; then
    warn "裸仓库已存在：${RELAY_BARE_PATH}"
    confirm "是否跳过创建，直接继续？" || die "已取消"
  else
    info "创建目录并初始化裸仓库..."
    ssh_run "
      set -e
      mkdir -p '$(dirname "${RELAY_BARE_PATH}")'
      mkdir -p '$(dirname "${RELAY_WORK_PATH}")'
      git init --bare '${RELAY_BARE_PATH}'
      git --git-dir='${RELAY_BARE_PATH}' config receive.denyNonFastForwards true
      git --git-dir='${RELAY_BARE_PATH}' config core.logAllRefUpdates true
      git --git-dir='${RELAY_BARE_PATH}' symbolic-ref HEAD 'refs/heads/${RELAY_BRANCH}'
      chmod -R 700 '$(dirname "${RELAY_BARE_PATH}")'
      chmod -R 700 '$(dirname "${RELAY_WORK_PATH}")'
    "
    success "裸仓库创建完成"
  fi

  # 检查工作区是否存在
  local wt_exists
  wt_exists="$(ssh_run "[ -d '${RELAY_WORK_PATH}/.git' ] && echo yes || echo no")"
  if [[ "$wt_exists" == "yes" ]]; then
    warn "工作区已存在：${RELAY_WORK_PATH}"
  else
    info "注意：工作区将在首次推送代码后自动 clone，请先运行 init-local 推送代码。"
  fi
}

# init-local — 本地添加 relay remote 并首次推送
cmd_init_local() {
  load_conf
  step "本地初始化：配置 relay remote 并首次推送"

  # 确保在 git 仓库中
  git rev-parse --git-dir &>/dev/null || die "当前目录不是 git 仓库，请先 cd 到项目目录"

  # 检查 corp remote
  if git remote | grep -q "^${RELAY_CORP_REMOTE}$"; then
    info "${RELAY_CORP_REMOTE} remote 已存在：$(git remote get-url "${RELAY_CORP_REMOTE}")"
  else
    # 检查是否有 origin，若有则建议改名
    if git remote | grep -q "^origin$"; then
      local origin_url
      origin_url="$(git remote get-url origin)"
      warn "检测到 origin remote: ${origin_url}"
      if confirm "是否将 origin 重命名为 ${RELAY_CORP_REMOTE}？"; then
        git remote rename origin "$RELAY_CORP_REMOTE"
        success "已将 origin 重命名为 ${RELAY_CORP_REMOTE}"
      else
        git remote add "$RELAY_CORP_REMOTE" "$RELAY_CORP_URL"
        success "已添加 ${RELAY_CORP_REMOTE} remote: ${RELAY_CORP_URL}"
      fi
    else
      git remote add "$RELAY_CORP_REMOTE" "$RELAY_CORP_URL"
      success "已添加 ${RELAY_CORP_REMOTE} remote: ${RELAY_CORP_URL}"
    fi
  fi

  # 检查 relay remote
  if git remote | grep -q "^${RELAY_RELAY_REMOTE}$"; then
    local existing_relay
    existing_relay="$(git remote get-url "${RELAY_RELAY_REMOTE}")"
    if [[ "$existing_relay" != "$RELAY_REMOTE_URL" ]]; then
      warn "${RELAY_RELAY_REMOTE} remote URL 与配置不一致"
      warn "  当前: ${existing_relay}"
      warn "  配置: ${RELAY_REMOTE_URL}"
      if confirm "是否更新 ${RELAY_RELAY_REMOTE} remote URL？"; then
        git remote set-url "$RELAY_RELAY_REMOTE" "$RELAY_REMOTE_URL"
        success "${RELAY_RELAY_REMOTE} remote URL 已更新"
      fi
    else
      info "${RELAY_RELAY_REMOTE} remote 已存在且 URL 一致：${RELAY_REMOTE_URL}"
    fi
  else
    git remote add "$RELAY_RELAY_REMOTE" "$RELAY_REMOTE_URL"
    success "已添加 ${RELAY_RELAY_REMOTE} remote: ${RELAY_REMOTE_URL}"
  fi

  echo
  info "当前 remote 列表："
  git remote -v

  # 首次推送
  echo
  if confirm "是否立即将主分支首次推送到 ${RELAY_RELAY_REMOTE}？"; then
    info "正在从 ${RELAY_CORP_REMOTE} 拉取最新代码..."
    git fetch "$RELAY_CORP_REMOTE" --prune
    git switch "$RELAY_BRANCH" 2>/dev/null || git checkout "$RELAY_BRANCH"
    git pull --ff-only "$RELAY_CORP_REMOTE" "$RELAY_BRANCH"
    info "推送主分支到 ${RELAY_RELAY_REMOTE}..."
    git push -u "$RELAY_RELAY_REMOTE" "$RELAY_BRANCH"
    git push "$RELAY_RELAY_REMOTE" --tags
    success "首次推送完成"

    # 在服务器上 clone 工作区
    echo
    if confirm "是否在外网服务器上 clone 工作区？"; then
      _server_clone_worktree
    fi
  fi
}

# 内部：服务器 clone 工作区
_server_clone_worktree() {
  local wt_exists
  wt_exists="$(ssh_run "[ -d '${RELAY_WORK_PATH}/.git' ] && echo yes || echo no")"
  if [[ "$wt_exists" == "yes" ]]; then
    warn "服务器工作区已存在：${RELAY_WORK_PATH}"
  else
    info "在服务器上 clone 工作区..."
    ssh_run "
      set -e
      git clone '${RELAY_BARE_PATH}' '${RELAY_WORK_PATH}'
    "
    success "服务器工作区 clone 完成：${RELAY_WORK_PATH}"
  fi

  info "服务器工作区 remote 列表："
  ssh_run "cd '${RELAY_WORK_PATH}' && git remote -v"
}

# init — 完整一次性初始化（服务器 + 本地）
cmd_init() {
  load_conf
  step "完整一次性初始化"
  echo "本命令将依次执行："
  echo "  1. 在外网服务器创建裸仓库"
  echo "  2. 本地配置 ${RELAY_CORP_REMOTE} / ${RELAY_RELAY_REMOTE} remote"
  echo "  3. 首次将代码推送到 ${RELAY_RELAY_REMOTE}"
  echo "  4. 在外网服务器 clone 工作区"
  echo
  confirm "确认继续？" || die "已取消"
  echo

  cmd_init_server
  echo
  cmd_init_local
}

# push-to-relay — 本地将公司最新代码推送到 relay
cmd_push_to_relay() {
  load_conf
  step "本地 → 同步公司代码到外网裸仓库"

  git rev-parse --git-dir &>/dev/null || die "当前目录不是 git 仓库"

  info "从 ${RELAY_CORP_REMOTE} 拉取最新代码..."
  git fetch "$RELAY_CORP_REMOTE" --prune

  info "切换到主分支 ${RELAY_BRANCH}..."
  git switch "$RELAY_BRANCH" 2>/dev/null || git checkout "$RELAY_BRANCH"

  info "fast-forward 合并 ${RELAY_CORP_REMOTE}/${RELAY_BRANCH}..."
  git pull --ff-only "$RELAY_CORP_REMOTE" "$RELAY_BRANCH"

  info "推送到 ${RELAY_RELAY_REMOTE}..."
  git push "$RELAY_RELAY_REMOTE" "$RELAY_BRANCH"
  git push "$RELAY_RELAY_REMOTE" --tags

  success "公司代码已同步到外网裸仓库"
  echo
  info "本地提交概览（最近 5 条）："
  git log --oneline -5
}

# relay-pull [分支名] — ssh 远程让服务器拉取指定分支（默认主分支）
cmd_server_pull() {
  local branch_name="${1:-}"
  load_conf

  local target_branch="${branch_name:-$RELAY_BRANCH}"
  step "外网服务器 → 从裸仓库拉取分支: ${target_branch}"

  info "服务器工作区: ${RELAY_WORK_PATH}"
  ssh_run "
    set -e
    cd '${RELAY_WORK_PATH}'
    git switch '${target_branch}' 2>/dev/null || git checkout '${target_branch}'
    git pull --ff-only origin '${target_branch}'
    echo '=== 最近 5 条提交 ==='
    git log --oneline -5
  "
  success "服务器工作区已更新到 ${target_branch} 最新代码"
}

# sync-to-relay — push-to-relay + relay-pull 一步完成
cmd_sync_corp_to_relay() {
  load_conf
  step "全链路同步：公司仓库 → 本地 → relay → 服务器工作区"
  cmd_push_to_relay
  echo
  cmd_server_pull
  echo
  success "同步完成！服务器工作区已是最新代码，可以开始开发。"
}

# feature-start <名称> — 在外网服务器创建功能分支
cmd_feature_start() {
  local feature_name="${1:-}"
  [[ -n "$feature_name" ]] || { prompt_input "分支名称" feature_name; }

  load_conf
  step "外网服务器 → 创建功能分支: ${feature_name}"

  ssh_run "
    set -e
    cd '${RELAY_WORK_PATH}'
    git switch '${RELAY_BRANCH}' 2>/dev/null || git checkout '${RELAY_BRANCH}'
    git pull --ff-only origin '${RELAY_BRANCH}'
    git switch -c '${feature_name}'
    echo '已创建并切换到分支: ${feature_name}'
    git branch -vv
  "
  success "功能分支 ${feature_name} 已在服务器创建"
  info "可以登录服务器开始开发，完成后运行: git-relay relay-push"
}

# relay-push [名称] — 外网服务器将当前功能分支推回裸仓库
cmd_feature_push() {
  local feature_name="${1:-}"
  load_conf
  step "外网服务器 → 推送功能分支到裸仓库"

  if [[ -n "$feature_name" ]]; then
    # 推指定分支
    ssh_run "
      set -e
      cd '${RELAY_WORK_PATH}'
      git push -u origin '${feature_name}'
      echo '=== 最近 5 条提交 ==='
      git log --oneline -5
    "
    success "功能分支 ${feature_name} 已推送到裸仓库"
  else
    # 推当前分支
    info "将推送服务器当前所在分支..."
    ssh_run "
      set -e
      cd '${RELAY_WORK_PATH}'
      current=\$(git rev-parse --abbrev-ref HEAD)
      echo \"当前分支: \${current}\"
      if [ \"\$current\" = '${RELAY_BRANCH}' ]; then
        echo '警告：当前在主分支，建议在功能分支上开发！'
        exit 1
      fi
      git push -u origin HEAD
      echo '=== 最近 5 条提交 ==='
      git log --oneline -5
    "
    success "服务器当前分支已推送到裸仓库"
  fi
}

# pull-from-relay <名称> — 本地从 relay 拉取功能分支
cmd_feature_pull() {
  local feature_name="${1:-}"
  [[ -n "$feature_name" ]] || { prompt_input "分支名称" feature_name; }

  load_conf
  step "本地 → 从 relay 拉取功能分支: ${feature_name}"

  git rev-parse --git-dir &>/dev/null || die "当前目录不是 git 仓库"

  info "从 ${RELAY_RELAY_REMOTE} 获取最新分支信息..."
  git fetch "$RELAY_RELAY_REMOTE" --prune

  local branch="${feature_name}"

  # 检查 relay 上是否有该分支
  if ! git branch -r | grep -q "${RELAY_RELAY_REMOTE}/${branch}"; then
    die "${RELAY_RELAY_REMOTE} 上不存在分支 ${branch}，请确认服务器已推送该分支"
  fi

  # 本地是否已有该分支
  if git branch --list "$branch" | grep -q "$branch"; then
    info "本地已有分支 ${branch}，执行更新..."
    git switch "$branch"
    git pull --ff-only "$RELAY_RELAY_REMOTE" "$branch"
    success "已更新本地 ${branch}"
  else
    info "首次拉取，创建本地跟踪分支..."
    git switch -c "$branch" --track "${RELAY_RELAY_REMOTE}/${branch}"
    success "已创建并跟踪 ${RELAY_RELAY_REMOTE}/${branch}"
  fi

  echo
  info "当前分支状态："
  git log --oneline -5
}

# relay-merge <名称> — 本地合并分支并推回公司仓库
# 若分支本身就是主分支，跳过 merge 直接推送
cmd_feature_merge() {
  local auto_yes=false
  if [[ "${1:-}" == "--yes" ]]; then
    auto_yes=true
    shift
  fi
  local feature_name="${1:-}"
  [[ -n "$feature_name" ]] || { prompt_input "分支名称" feature_name; }

  load_conf

  local branch="${feature_name}"

  git rev-parse --git-dir &>/dev/null || die "当前目录不是 git 仓库"

  if [[ "$branch" == "$RELAY_BRANCH" ]]; then
    # ── 分支本身就是主分支：直接推送，无需 merge ──────────────────────
    step "本地 → 将 ${branch} 推回公司仓库"

    git switch "$RELAY_BRANCH" 2>/dev/null || git checkout "$RELAY_BRANCH"

    echo
    info "当前提交记录（最近 8 条）："
    git log --oneline --graph -8
    echo

    if ! $auto_yes; then
      confirm "确认推送到 ${RELAY_CORP_REMOTE}/${RELAY_BRANCH}？" || die "已取消"
    fi

    git push "$RELAY_CORP_REMOTE" "$RELAY_BRANCH"
    success "已推送到公司仓库"

    info "同步回 ${RELAY_RELAY_REMOTE}..."
    git push "$RELAY_RELAY_REMOTE" "$RELAY_BRANCH"
    success "${RELAY_RELAY_REMOTE} 主分支已同步"

  else
    # ── 功能分支：merge 进主分支再推送 ────────────────────────────────
    step "本地 → 合并 ${branch} 并推回公司仓库"

    if ! git branch --list "$branch" | grep -q "$branch"; then
      die "本地不存在分支 ${branch}，请先运行: git-relay pull-from-relay ${feature_name}"
    fi

    info "更新本地主分支..."
    git fetch "$RELAY_CORP_REMOTE" --prune
    git switch "$RELAY_BRANCH" 2>/dev/null || git checkout "$RELAY_BRANCH"
    git pull --ff-only "$RELAY_CORP_REMOTE" "$RELAY_BRANCH"

    info "合并 ${branch}（--no-ff）..."
    git merge --no-ff "$branch"

    echo
    info "合并后提交记录（最近 8 条）："
    git log --oneline --graph -8
    echo

    if ! $auto_yes; then
      confirm "确认推送到 ${RELAY_CORP_REMOTE}/${RELAY_BRANCH}？" || die "已取消，保留合并结果，可手动推送"
    fi

    git push "$RELAY_CORP_REMOTE" "$RELAY_BRANCH"
    success "已推送到公司仓库"

    info "同步回 ${RELAY_RELAY_REMOTE}..."
    git push "$RELAY_RELAY_REMOTE" "$RELAY_BRANCH"
    success "${RELAY_RELAY_REMOTE} 主分支已同步"

    if ! $auto_yes; then
      if confirm "是否同时更新外网服务器工作区主分支？"; then
        cmd_server_pull
      fi
    fi
  fi
}

# sync-from-relay [名称] — 服务器提交一键同步回公司仓库
cmd_sync_server_to_corp() {
  local feature_name="${1:-}"
  [[ -n "$feature_name" ]] || { prompt_input "分支名称" feature_name; }

  load_conf
  step "全链路同步：服务器功能分支 → relay → 本地 → 公司仓库"
  echo "本命令将依次执行："
  echo "  1. 服务器推送 ${feature_name} 到裸仓库"
  echo "  2. 本地从 relay 拉取该分支"
  if [[ "$feature_name" == "$RELAY_BRANCH" ]]; then
    echo "  3. 将本地 ${feature_name} 直接推回公司仓库（无需 merge）"
  else
    echo "  3. 本地合并并推回公司仓库"
  fi
  echo
  confirm "确认继续？" || die "已取消"

  cmd_feature_push "$feature_name"
  echo
  cmd_feature_pull "$feature_name"
  echo
  cmd_feature_merge --yes "$feature_name"
}

# feature-clean <名称> — 清理功能分支（本地 + relay + 服务器）
cmd_feature_clean() {
  local feature_name="${1:-}"
  [[ -n "$feature_name" ]] || { prompt_input "分支名称" feature_name; }

  load_conf
  step "清理功能分支: ${feature_name}"
  echo "将删除："
  echo "  - 本地分支:          ${feature_name}"
  echo "  - relay remote 分支: relay/${feature_name}"
  echo "  - 服务器本地分支:    ${feature_name}（切回主分支）"
  echo

  confirm "确认清理？" || die "已取消"

  local branch="${feature_name}"

  # 本地删除
  if git branch --list "$branch" | grep -q "$branch"; then
    local current_branch
    current_branch="$(git rev-parse --abbrev-ref HEAD)"
    if [[ "$current_branch" == "$branch" ]]; then
      git switch "$RELAY_BRANCH" 2>/dev/null || git checkout "$RELAY_BRANCH"
    fi
    git branch -d "$branch" && success "已删除本地分支 ${branch}" || warn "本地分支删除失败（可能有未合并提交）"
  else
    info "本地无分支 ${branch}，跳过"
  fi

  # 删除 relay 远程分支
  if git fetch "$RELAY_RELAY_REMOTE" --prune 2>/dev/null; then
    if git branch -r | grep -q "${RELAY_RELAY_REMOTE}/${branch}"; then
      git push "$RELAY_RELAY_REMOTE" --delete "$branch" && success "已删除 ${RELAY_RELAY_REMOTE}/${branch}" || warn "${RELAY_RELAY_REMOTE} 分支删除失败"
    else
      info "${RELAY_RELAY_REMOTE} 上无分支 ${branch}，跳过"
    fi
  fi

  # 服务器清理
  info "清理服务器上的分支..."
  ssh_run "
    set -e
    cd '${RELAY_WORK_PATH}'
    git fetch --prune
    current=\$(git rev-parse --abbrev-ref HEAD)
    if [ \"\$current\" = '${branch}' ]; then
      git switch '${RELAY_BRANCH}' 2>/dev/null || git checkout '${RELAY_BRANCH}'
    fi
    if git branch --list '${branch}' | grep -q '${branch}'; then
      git branch -d '${branch}' && echo '服务器本地分支已删除' || echo '警告：服务器分支删除失败'
    else
      echo '服务器无该分支，跳过'
    fi
    git fetch --prune
  " || warn "服务器清理时出现错误，请手动检查"

  success "清理完成"
}

# status — 显示当前状态
cmd_status() {
  load_conf || true
  step "当前仓库状态"

  git rev-parse --git-dir &>/dev/null || die "当前目录不是 git 仓库"

  echo
  info "=== Remote 列表 ==="
  git remote -v

  echo
  info "=== 本地分支跟踪关系 ==="
  git branch -vv

  echo
  info "=== 提交历史（最近 10 条，所有分支）==="
  git log --oneline --graph --decorate --all -10
}

# ── 入口 ──────────────────────────────────────────────────────────────────────
main() {
  local cmd="${1:-}"

  case "$cmd" in
    config)            shift; cmd_config "$@" ;;
    config-show)       shift; cmd_config_show "$@" ;;
    init)              shift; cmd_init "$@" ;;
    init-server)       shift; cmd_init_server "$@" ;;
    init-local)        shift; cmd_init_local "$@" ;;
    push-to-relay)     shift; cmd_push_to_relay "$@" ;;
    relay-pull)       shift; cmd_server_pull "$@" ;;
    feature-start)     shift; cmd_feature_start "$@" ;;
    relay-push)      shift; cmd_feature_push "$@" ;;
    pull-from-relay)      shift; cmd_feature_pull "$@" ;;
    relay-merge)     shift; cmd_feature_merge "$@" ;;
    feature-clean)     shift; cmd_feature_clean "$@" ;;
    sync-to-relay)  shift; cmd_sync_corp_to_relay "$@" ;;
    sync-from-relay) shift; cmd_sync_server_to_corp "$@" ;;
    status)            shift; cmd_status "$@" ;;
    --help|-h|help)    show_help ;;
    --version|-v)      echo "git-relay ${VERSION}" ;;
    "")
      show_help
      exit 0
      ;;
    *)
      error "未知子命令: ${cmd}"
      echo
      show_help
      exit 1
      ;;
  esac
}

main "$@"
